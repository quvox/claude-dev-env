#!/bin/bash
# =============================================================================
# claude-dev-mac - Claude Code 安全開発環境 CLI（macOS 版）
# =============================================================================
# macOS + Docker Desktop 上で、コンテナ隔離された Claude Code 環境を起動する。
# Linux 版 claude-dev の macOS 適応版。ホスト側 CLI の差分は SSH agent 転送・
# Docker ソケット検出・VM/KVM 非対応・ポートフォワード直結案内の 4 点。加えて
# Apple Silicon 向けにネイティブ arm64 で動かす（gcloud/Chrome のアーキ差分は共有イメージ側で
# 吸収）。設計: docs/09_macos-support.md §1-§5。
# コンテナ内資産のうち firewall / docker-proxy / tmux.conf は Linux 版と共有。Dockerfile /
# entrypoint は arm64 対応のアーキ別分岐を持つが amd64 では従来と同一（後方互換）。
# =============================================================================
set -e

# --- パス解決 ---
# `make install` は /usr/local/bin/claude-dev を本スクリプトへの symlink（sudo ln -sf）にする。
# readlink -f が symlink を解決するため BASE_DIR は repo を指す（repo 直実行時も同様）。
SCRIPT_PATH="$(readlink -f "$0" 2>/dev/null || realpath "$0")"
BASE_DIR="$(dirname "$SCRIPT_PATH")"
CONFIG_FILE="${BASE_DIR}/.env"

# --- 設定読み込み ---
if [ -f "$CONFIG_FILE" ]; then
    set -a
    source "$CONFIG_FILE"
    set +a
fi

# --- Docker CLI の "What's next:" ヒントを抑制 ---
# docker run / exec 後（tmux から抜けた時など）に出るプロモ表示を止める。
# 利用者が明示設定していればそれを尊重する。
export DOCKER_CLI_HINTS="${DOCKER_CLI_HINTS:-false}"

# --- 定数 ---
NETWORK="claude-dev-net"
NOVNC_BASE_PORT=6080   # noVNC ポート開始番号
FWD_PORT_BASE=8100     # ポートフォワード用開始番号
VOL_AUTH="claude-dev-auth"
VOL_HISTORY="claude-dev-history"
VOL_CONFIG="claude-dev-config"
# Chrome プロファイルはコンテナごとに分離する（共有すると複数コンテナ同時起動時に
# 同一プロファイルへ多重書き込みし SingletonLock 奪取・プロファイル破損を招く）。
# 実体は `${VOL_CHROME_PREFIX}-<container_name>`（VM ボリューム claude-dev-vm-<name> と同方式）。
VOL_CHROME_PREFIX="claude-dev-chrome"
IMG_CLAUDE="claude-dev-claude"
IMG_CLAUDE_VNC="claude-dev-claude-vnc"
IMG_DOCKER_PROXY="claude-dev-docker-proxy"
DOCKER_PROXY_CONTAINER="claude-dev-docker-proxy"

# --- コンテナ内ユーザー名 ---
# 実行するイメージに焼き込まれた CONTAINER_USER を優先する（GHCR の generic user=dev 対応）。
# イメージが無ければホストの whoami にフォールバック（ローカルビルド運用は従来どおり＝後方互換）。
CUSER="$(docker image inspect "$IMG_CLAUDE" --format '{{range .Config.Env}}{{println .}}{{end}}' 2>/dev/null | sed -n 's/^CONTAINER_USER=//p' | head -1)"
[ -n "$CUSER" ] || CUSER="$(whoami)"
CHOME="/home/${CUSER}"

# 起動中コンテナへ exec する際のユーザーは、ローカルイメージのタグではなく「そのコンテナ自身に
# 焼き込まれた CONTAINER_USER」から解決する。make build 等でローカルイメージのユーザーが変わっても
# （例: GHCR=dev とローカルビルド=<whoami> の混在）、別イメージ由来で稼働中のコンテナへ正しい -u で
# attach できる。見つからなければ CUSER（イメージ由来）へフォールバック。
resolve_container_user() {
    local _u
    _u="$(docker inspect "$1" --format '{{range .Config.Env}}{{println .}}{{end}}' 2>/dev/null | sed -n 's/^CONTAINER_USER=//p' | head -1)"
    [ -n "$_u" ] || _u="$CUSER"
    printf '%s' "$_u"
}

# --- プラットフォーム ---
# ネイティブアーキでビルド/実行する（Apple Silicon = arm64 / Intel Mac = amd64）。
# 共有 Dockerfile はアーキ別に対応済み（arm64 は Playwright Chromium・gcloud は arm 写像。
# 設計 docs/09_macos-support.md §5）。エミュレーションは使わない。
# 利用者が DOCKER_DEFAULT_PLATFORM を明示している場合のみそれを尊重する。

# =============================================================================
# ヘルパー関数
# =============================================================================

# --- 設定/作業ディレクトリ / SSH（方式D: 専用 agent＋socat TCP ブリッジ）---
# 設計 docs/09_macos-support.md §1 / 実装仕様 docs/impl/11_cli-mac.md D1
DEV_DIR="${HOME}/.claude-dev"
DEV_AGENT_DIR="${DEV_DIR}/agents"               # プロジェクト専用 agent/ブリッジのソケット・PID 置き場（<name>.sock/.pid/.bridge.pid/.bridge.port）
PROJECT_CONFIG_NAME=".claude-dev.yaml"          # プロジェクト直下の設定ファイル名（このプロジェクトで使う SSH 鍵）
# 後方互換: 旧・単一 agent/ブリッジのファイル（reset で掃除する）
LEGACY_AGENT_SOCK="${DEV_DIR}/ssh-agent.sock"
LEGACY_AGENT_PID_FILE="${DEV_DIR}/ssh-agent.pid"
LEGACY_BRIDGE_PID_FILE="${DEV_DIR}/ssh-bridge.pid"
LEGACY_BRIDGE_PORT_FILE="${DEV_DIR}/ssh-bridge.port"

# プロジェクト（name）ごとの agent/ブリッジのファイルパスを stdout に返す
# 用途: sock|pid|bpid|bport
dev_agent_path() {
    case "$2" in
        sock)  echo "${DEV_AGENT_DIR}/$1.sock" ;;
        pid)   echo "${DEV_AGENT_DIR}/$1.pid" ;;
        bpid)  echo "${DEV_AGENT_DIR}/$1.bridge.pid" ;;
        bport) echo "${DEV_AGENT_DIR}/$1.bridge.port" ;;
    esac
}

# ~/.ssh/id_*（.pub 除く）を DISCOVERED_KEYS に列挙
discover_ssh_keys() {
    DISCOVERED_KEYS=()
    local f
    for f in "$HOME"/.ssh/id_*; do
        case "$f" in *.pub) continue ;; esac
        [ -f "$f" ] && DISCOVERED_KEYS+=("$f")
    done
}

# 指定 YAML の ssh_keys: を SSH_KEY_LIST に読み込む（追記。~→$HOME 展開・コメント除去）
_parse_ssh_keys_yaml() {
    local config="$1"
    [ -f "$config" ] || return 0
    local line val in_section=0
    while IFS= read -r line; do
        case "$line" in \#*|"") continue ;; esac
        if [[ "$line" =~ ^ssh_keys: ]]; then in_section=1; continue; fi
        if [[ $in_section -eq 1 && "$line" =~ ^[a-zA-Z_] ]]; then break; fi
        if [[ $in_section -eq 1 && "$line" =~ ^[[:space:]]*-[[:space:]]+(.*) ]]; then
            val="${BASH_REMATCH[1]}"; val="${val%%#*}"
            val="$(echo "$val" | sed 's/^[[:space:]]*//;s/[[:space:]]*$//')"
            val="${val/#\~/$HOME}"
            [ -n "$val" ] && SSH_KEY_LIST+=("$val")
        fi
    done < "$config"
}

# 使う鍵を <project_dir>/.claude-dev.yaml の ssh_keys からのみ解決して
# SSH_KEY_LIST / SSH_CONFIG_SOURCE を設定する（グローバル config へのフォールバックや
# 対話選択・自動生成はしない＝ローカル設定だけを見る）。
resolve_ssh_keys_for_start() {
    local project_dir="$1"
    local project_config="${project_dir}/${PROJECT_CONFIG_NAME}"
    SSH_KEY_LIST=()
    SSH_CONFIG_SOURCE="$project_config"
    _parse_ssh_keys_yaml "$project_config"
}

# 選択鍵をプロジェクト直下の .claude-dev.yaml に書き出す（引数=ファイルパス, 鍵パス群）
write_project_ssh_keys() {
    local file="$1"; shift
    {
        echo "# claude-dev プロジェクト設定（このプロジェクトで使う SSH 鍵。claude-dev が管理します）"
        echo "# 再選択は 'claude-dev ssh-keys'、初期化は 'claude-dev ssh-keys reset'"
        echo "ssh_keys:"
        local k
        for k in "$@"; do echo "  - $k"; done
    } > "$file"
}

# ~/.ssh の鍵を対話選択し、カレントプロジェクトの .claude-dev.yaml に保存。SSH_KEY_LIST にも反映
select_ssh_keys_interactive() {
    local file="$(pwd)/${PROJECT_CONFIG_NAME}"
    discover_ssh_keys
    if [ ${#DISCOVERED_KEYS[@]} -eq 0 ]; then
        echo "⚠️  ~/.ssh に鍵ファイル（id_*）が見つかりません。SSH 転送なしで続行します。"
        write_project_ssh_keys "$file"
        SSH_KEY_LIST=()
        return 0
    fi
    echo "利用可能な SSH 鍵:"
    local i=1 k
    for k in "${DISCOVERED_KEYS[@]}"; do echo "  $i) $k"; i=$((i + 1)); done
    printf "このプロジェクトで使う鍵を選択 (番号をカンマ/空白区切り, a=全部, n=なし): "
    local ans=""; read -r ans || ans=""
    local chosen=() tok
    case "$ans" in
        a|A|all|ALL) chosen=("${DISCOVERED_KEYS[@]}") ;;
        n|N|none|NONE|"") chosen=() ;;
        *)
            for tok in $(echo "$ans" | tr ',' ' '); do
                case "$tok" in ''|*[!0-9]*) continue ;; esac
                if [ "$tok" -ge 1 ] && [ "$tok" -le ${#DISCOVERED_KEYS[@]} ]; then
                    chosen+=("${DISCOVERED_KEYS[$((tok - 1))]}")
                fi
            done
            ;;
    esac
    write_project_ssh_keys "$file" "${chosen[@]}"
    echo "✅ SSH 鍵の選択を保存しました: $file（${#chosen[@]} 件）"
    SSH_KEY_LIST=("${chosen[@]}")
}

# プロジェクト専用 ssh-agent（~/.claude-dev/agents/<name>.sock）を起動/再利用し、
# SSH_KEY_LIST の鍵だけを ssh-add する。引数: <name>。成功で 0。
ensure_dedicated_agent() {
    local name="${1:-default}"
    local sock pidfile
    sock=$(dev_agent_path "$name" sock)
    pidfile=$(dev_agent_path "$name" pid)
    mkdir -p "$DEV_AGENT_DIR"
    chmod 700 "$DEV_DIR" "$DEV_AGENT_DIR" 2>/dev/null || true
    local rc=0
    SSH_AUTH_SOCK="$sock" ssh-add -l >/dev/null 2>&1 || rc=$?
    if [ "$rc" -eq 2 ] || [ ! -S "$sock" ]; then
        # 残骸の掃除。ソケット以外のもの（Docker が bind-mount のソースとして作った
        # root 所有のディレクトリ等）が居座っていることがある。`rm -f` はディレクトリに
        # 失敗し、`set -e` の下では start ごと落ちてしまうため、消せなかった場合は
        # 停止せず案内して SSH 転送だけ諦める（前提不足は停止しない方針）。
        if [ -e "$sock" ] || [ -L "$sock" ]; then
            rm -rf "$sock" 2>/dev/null || true
        fi
        if [ -e "$sock" ] || [ -L "$sock" ]; then
            echo "⚠️  ${sock} がソケットではなく、削除もできませんでした"
            echo "    sudo rm -rf '${sock}' で取り除いてください。SSH 転送なしで続行します"
            return 1
        fi
        local out
        out=$(ssh-agent -a "$sock" 2>/dev/null) || {
            echo "⚠️  専用 ssh-agent の起動に失敗しました"; return 1; }
        echo "$out" | sed -n 's/.*SSH_AGENT_PID=\([0-9][0-9]*\).*/\1/p' | head -1 > "$pidfile"
        echo "🔑 プロジェクト専用 ssh-agent を起動しました（$name）"
    fi
    # 既登録鍵の指紋（パスフレーズ再入力を避けるため突き合わせる）
    local loaded_fps
    loaded_fps="$(SSH_AUTH_SOCK="$sock" ssh-add -l 2>/dev/null | awk '{print $2}')"
    # 存在チェック → 既登録スキップ → パスフレーズなし一括 → 残りを対話追加
    local key keys=() need_pp=()
    for key in "${SSH_KEY_LIST[@]}"; do
        [ -f "$key" ] || { echo "⚠️  ${key}: 見つかりません（スキップ）"; continue; }
        local fp
        fp="$(ssh-keygen -lf "$key" 2>/dev/null | awk '{print $2}')"
        if [ -n "$fp" ] && printf '%s\n' "$loaded_fps" | grep -qxF "$fp"; then
            continue   # 既に登録済み
        fi
        keys+=("$key")
    done
    for key in "${keys[@]}"; do
        if SSH_AUTH_SOCK="$sock" SSH_ASKPASS=/bin/false SSH_ASKPASS_REQUIRE=force ssh-add "$key" 2>/dev/null; then
            :
        else
            need_pp+=("$key")
        fi
    done
    if [ ${#need_pp[@]} -gt 0 ]; then
        echo "🔑 パスフレーズ付きの鍵を専用 agent に追加します（初回のみ入力）:"
        for key in "${need_pp[@]}"; do
            SSH_AUTH_SOCK="$sock" ssh-add "$key" || echo "⚠️  ${key}: 追加できませんでした（スキップ）"
        done
    fi
    return 0
}

# 空き 127.0.0.1 TCP ポートを返す（9700〜。forward(8100〜)/noVNC(6080〜) と重ならない範囲）
find_free_local_port() {
    local p
    for p in $(seq 9700 9799); do
        if ! (: </dev/tcp/127.0.0.1/"$p") 2>/dev/null; then echo "$p"; return 0; fi
    done
    echo 9700
}

# プロジェクト専用 agent への host socat ブリッジを起動し、使用中ポートを標準出力に返す
# 引数: <name>。socat が無い/起動失敗なら非0を返す（呼び出し側は SSH 転送をスキップ）
ensure_ssh_bridge() {
    local name="${1:-default}"
    local sock bpid bport
    sock=$(dev_agent_path "$name" sock)
    bpid=$(dev_agent_path "$name" bpid)
    bport=$(dev_agent_path "$name" bport)
    if ! command -v socat >/dev/null 2>&1; then
        echo "⚠️  socat が見つかりません。SSH agent 転送には socat が必要です。" >&2
        echo "    👉 導入してください:  brew install socat" >&2
        echo "    （導入後に 'claude-dev start' を再実行してください。今回は SSH agent 転送なしで続行します）" >&2
        return 1
    fi
    mkdir -p "$DEV_AGENT_DIR"
    # 既存ブリッジ（このプロジェクト用）が生きていればその port を再利用
    if [ -f "$bpid" ] && [ -f "$bport" ] \
       && kill -0 "$(cat "$bpid" 2>/dev/null)" 2>/dev/null; then
        cat "$bport"
        return 0
    fi
    local port="${CLAUDE_DEV_SSH_BRIDGE_PORT:-}"
    [ -n "$port" ] || port=$(find_free_local_port)
    nohup socat "TCP-LISTEN:${port},bind=127.0.0.1,fork,reuseaddr" "UNIX-CONNECT:${sock}" >/dev/null 2>&1 &
    echo $! > "$bpid"
    echo "$port" > "$bport"
    echo "$port"
}

# 指定プロジェクトのブリッジ socat を停止（専用 agent は残す＝鍵保持・TCP 露出なし）
# 引数: <name>
stop_ssh_bridge() {
    local name="${1:-default}"
    local bpid bport
    bpid=$(dev_agent_path "$name" bpid)
    bport=$(dev_agent_path "$name" bport)
    if [ -f "$bpid" ]; then
        kill "$(cat "$bpid" 2>/dev/null)" 2>/dev/null || true
        rm -f "$bpid" "$bport"
        echo "🔌 SSH ブリッジを停止しました（$name）"
    fi
}

# プロジェクト名（カレントディレクトリから導出）
project_name() {
    basename "$(pwd)" | tr '[:upper:]' '[:lower:]' | sed 's/[^a-z0-9._-]/-/g'
}

# コンテナ名（= ディレクトリ名）
container_name() {
    project_name
}

# Docker ソケットのパスを検出（macOS/Docker Desktop 対応）
# /var/run/docker.sock（既定ソケット有効時のシンボリックリンク）を優先し、
# 無ければ Docker Desktop の既定ソケット ~/.docker/run/docker.sock を探す。
# 見つかったパスを標準出力へ返す（無ければ空文字）。
detect_docker_sock() {
    if [ -S /var/run/docker.sock ]; then
        echo "/var/run/docker.sock"
    elif [ -S "${HOME}/.docker/run/docker.sock" ]; then
        echo "${HOME}/.docker/run/docker.sock"
    fi
}

# イメージが存在するか
image_exists() {
    docker image inspect "$1" >/dev/null 2>&1
}

# コンテナが実行中か
is_running() {
    docker ps -q -f "name=^${1}$" 2>/dev/null | grep -q .
}

# コンテナが存在するか（停止含む）
container_exists() {
    docker ps -aq -f "name=^${1}$" 2>/dev/null | grep -q .
}

# 使用可能な noVNC ポートを探す
find_available_novnc_port() {
    local port=$NOVNC_BASE_PORT
    while [ $port -lt $((NOVNC_BASE_PORT + 100)) ]; do
        if ! docker ps --format '{{.Ports}}' 2>/dev/null | grep -q "0.0.0.0:${port}->"; then
            echo "$port"
            return
        fi
        port=$((port + 1))
    done
    echo "$NOVNC_BASE_PORT"
}

# 使用可能なホストポートを探す
find_available_host_port() {
    local port=$FWD_PORT_BASE
    local max=$((FWD_PORT_BASE + 900))
    while [ $port -lt $max ]; do
        if ! docker ps --format '{{.Ports}}' 2>/dev/null | grep -q "0.0.0.0:${port}->"; then
            echo "$port"
            return
        fi
        port=$((port + 1))
    done
    echo "$FWD_PORT_BASE"
}

# セットアップ済みか確認（イメージがなければ自動ビルド）
require_setup() {
    if ! image_exists "$IMG_CLAUDE"; then
        echo "📦 Claude ベースイメージが見つかりません。ビルドします..."
        docker build -t "$IMG_CLAUDE" \
            --target claude-cli \
            --build-arg USERNAME="$CUSER" \
            --build-arg USER_UID="$(id -u)" \
            --build-arg USER_GID="$(id -g)" \
            -f "${BASE_DIR}/.devcontainer/Dockerfile.claude" "$BASE_DIR"
    fi
    if ! image_exists "$IMG_CLAUDE_VNC"; then
        echo "📦 Claude VNC イメージが見つかりません。ビルドします..."
        docker build -t "$IMG_CLAUDE_VNC" \
            --target claude-vnc \
            --build-arg USERNAME="$CUSER" \
            --build-arg USER_UID="$(id -u)" \
            --build-arg USER_GID="$(id -g)" \
            -f "${BASE_DIR}/.devcontainer/Dockerfile.claude" "$BASE_DIR"
    fi
}

# 起動に必要なホストコマンドを確認し、無ければ導入方法を案内して終了する。
# macOS では SSH agent 転送に socat（TCP ブリッジ）が必須。
check_host_deps() {
    local missing=() c
    for c in docker jq socat; do
        command -v "$c" >/dev/null 2>&1 || missing+=("$c")
    done
    [ ${#missing[@]} -eq 0 ] && return 0
    echo "❌ 起動に必要なコマンドが見つかりません: ${missing[*]}" >&2
    echo "   👉 導入してから再実行してください:" >&2
    for c in "${missing[@]}"; do
        case "$c" in
            docker) echo "      Docker Desktop を導入: https://www.docker.com/products/docker-desktop/" >&2 ;;
            *)      echo "      brew install $c" >&2 ;;
        esac
    done
    exit 1
}

# <project_dir>/.claude-dev.yaml が無ければ SSH 鍵選択を促し（TTY 時）、無選択/非対話
# なら ssh_keys 空配列で作成する。既存ファイルは尊重して何もしない（起動のたびに聞かない）。
ensure_project_config() {
    local project_dir="$1"
    local cfg="${project_dir}/${PROJECT_CONFIG_NAME}"
    [ -f "$cfg" ] && return 0
    if [ -t 0 ]; then
        echo "🔧 このプロジェクトに ${PROJECT_CONFIG_NAME} がありません。コンテナへ転送する SSH 鍵を選択します（不要なら n）。"
        select_ssh_keys_interactive
    else
        write_project_ssh_keys "$cfg"
        echo "🔧 ${PROJECT_CONFIG_NAME} を作成しました（ssh_keys 空＝SSH 転送なし。'claude-dev ssh-keys' で後から選択可）"
    fi
}

# Docker リソースの準備
ensure_infrastructure() {
    docker network create "$NETWORK" 2>/dev/null || true
    docker volume create "$VOL_AUTH" >/dev/null 2>&1 || true
    docker volume create "$VOL_HISTORY" >/dev/null 2>&1 || true
    docker volume create "$VOL_CONFIG" >/dev/null 2>&1 || true
    # Chrome プロファイルはコンテナごとのボリューム（docker run が自動作成）なのでここでは作らない
}

# 指定コンテナの noVNC URL を取得
get_novnc_url() {
    local port
    port=$(docker port "$1" 6080 2>/dev/null | head -1 | sed 's/.*://')
    if [ -n "$port" ]; then
        echo "http://localhost:${port}/vnc.html?autoconnect=true"
    fi
}

# 指定イメージ（または image ID）のバージョン表記を返す
# org.opencontainers.image.version ラベル優先（CI=YYYYMMDDHHmm / ローカル=local）、
# 無ければ unknown。あわせて短縮 ID と作成日時を付す。
image_version() {
    local ref="$1" v id created
    v=$(docker image inspect "$ref" --format '{{index .Config.Labels "io.github.quvox.claude-dev.version"}}' 2>/dev/null)
    id=$(docker image inspect "$ref" --format '{{.Id}}' 2>/dev/null | sed 's/^sha256://' | cut -c1-12)
    created=$(docker image inspect "$ref" --format '{{.Created}}' 2>/dev/null | cut -c1-16 | tr 'T' ' ')
    case "$v" in ""|"<no value>") v="unknown" ;; esac
    echo "${v} (id ${id}, built ${created})"
}

# =============================================================================
# 排他ロック（MODULE-cli-common-lock / CTR-cli-container「排他（ロックキー）」）
# =============================================================================
# 共有ボリュームまたは docker-proxy を触る 6 コマンド（start / stop / logout /
# reset / login / login-codex）を直列化する。キーは 2 段:
#   プロジェクト単位 = 対象コンテナ名 / 共有資源単位 = 固定文字列 shared
# 両方を取る操作は「プロジェクト単位 → 共有資源単位」の固定順で取る。待たない。
LOCK_DIR="${DEV_DIR}/locks"
_HELD_LOCK_PATHS=()

# ロックファイルのパスを決める。<種別> は project / shared。
# **種別ごとに名前空間を分ける**のは、プロジェクト名が `shared` のとき（`~/work/shared` で
# `claude-dev start` したとき）にプロジェクト単位のキーと共有資源単位の固定キーが同じ
# ファイルを指し、2 段目の取得が「自分が持っているロック」を他人と誤認して必ず失敗する
# ためである（キーの値そのものは契約 CTR-cli-container のとおりコンテナ名 / shared）。
_lock_path() {
    if [ "$2" = "shared" ]; then
        printf '%s/shared.lock' "$LOCK_DIR"
    else
        printf '%s/proj-%s.lock' "$LOCK_DIR" "$1"
    fi
}

# ロックの実体を作る。`ln -s` は同名パスがあると失敗するため、これが原子的な取得である。
# 向き先の文字列 "<PID> <操作名>" が保持者の記録を兼ねるので、「ロックはあるが所有者が
# 未記録」という中間状態が原理的に存在しない（判断8）。向き先は実在パスでなくてよい。
_lock_link() {
    ln -s "$$ $2" "$1" 2>/dev/null
}

_lock_busy_message() {
    local key="$1" pid="$2" op="$3"
    echo "❌ 排他ロックを取得できませんでした（キー: ${key}）。削除も作成も行っていません。" >&2
    if [ -n "$pid" ]; then
        echo "   保持している操作: ${op}（PID ${pid}）" >&2
    else
        echo "   別の操作がほぼ同時に同じロックを取得しました。" >&2
    fi
    echo "   待たずに終了します。その操作が終わってから再実行してください。" >&2
}

# 保持中のロックをすべて解放する（EXIT / INT / TERM の trap から呼ぶ）。
# 終了コードを変えない。
_release_all_locks() {
    local _rc=$? _paths=("${_HELD_LOCK_PATHS[@]}") p
    for p in "${_paths[@]}"; do
        _release_lock_path "$p"
    done
    return $_rc
}

# acquire_lock <key> <操作名> <種別: project|shared>
#   取得できたら 0、できなければ理由を stderr に出して非 0 を返す（待たない）。
acquire_lock() {
    local key="$1" op="$2" kind="${3:-project}" lockfile holder pid hop stale taken tpid
    case "$key" in
        ""|*[!A-Za-z0-9._-]*)
            echo "❌ ロックキーに受理できない文字が含まれています: '${key}'" >&2
            echo "   受理する文字は [A-Za-z0-9._-] だけです。何も行っていません。" >&2
            return 1
            ;;
    esac
    if ! mkdir -p "$LOCK_DIR" 2>/dev/null; then
        echo "❌ ロックの置き場所を作成できません: ${LOCK_DIR}" >&2
        return 1
    fi
    chmod 700 "$LOCK_DIR" 2>/dev/null || true

    # 取得より前に trap を仕掛ける（取得直後に中断しても後始末が走るように）。
    # release_lock は所有者確認つきで冪等なので、ロックを持つ前に発火しても無害。
    trap '_release_all_locks' EXIT
    trap '_release_all_locks; exit 130' INT TERM

    lockfile="$(_lock_path "$key" "$kind")"
    if _lock_link "$lockfile" "$op"; then
        _HELD_LOCK_PATHS+=("$lockfile")
        return 0
    fi

    if ! holder=$(readlink "$lockfile" 2>/dev/null); then
        # リンクが消えていた（直前に別プロセスが解放した）。もう一度だけ試す。
        if _lock_link "$lockfile" "$op"; then
            _HELD_LOCK_PATHS+=("$lockfile")
            return 0
        fi
        _lock_busy_message "$key" "" ""
        return 1
    fi
    pid="${holder%% *}"
    hop="${holder#* }"

    if kill -0 "$pid" 2>/dev/null; then
        _lock_busy_message "$key" "$pid" "$hop"
        return 1
    fi

    # 残骸の回収。mv（rename）で引き取ってから、**引き取った中身を必ず検証する**。
    # mv が原子的なのは「そのパスの rename に成功するのは 1 プロセスだけ」という点であって、
    # **引き取った中身が観測した残骸と同じであることは保証しない**。同じ残骸を見つけた別
    # プロセスが先に引き取りを完走していると、その後に張られた「生きているロック」を奪える。
    # 検証せずに rm -f すると、その時点で 2 プロセスが同じ臨界区間に入る（判断6）。
    stale="${lockfile}.stale.$$"
    if ! mv "$lockfile" "$stale" 2>/dev/null; then
        # 既に他プロセスが引き取った、または解放された。取得失敗として扱う。
        _lock_busy_message "$key" "" ""
        return 1
    fi
    taken=$(readlink "$stale" 2>/dev/null) || taken=""
    tpid="${taken%% *}"
    if [ "$taken" != "$holder" ] && [ -n "$taken" ] && kill -0 "$tpid" 2>/dev/null; then
        # 観測した残骸ではなく、別プロセスが張り直した「生きているロック」を奪ってしまった。
        # 元に戻してから取得失敗として扱う（奪ったまま自分が取ると二重取得になる）。
        if ! ln -s "$taken" "$lockfile" 2>/dev/null; then
            echo "❌ ロックを元に戻せませんでした（キー: ${key}）。別の操作が同じキーを取得した可能性があります。" >&2
            echo "   実行中の操作をすべて終えてから、${lockfile} を確認してください。" >&2
        fi
        rm -f "$stale" 2>/dev/null || true
        _lock_busy_message "$key" "$tpid" "${taken#* }"
        return 1
    fi
    # ここまで来たものは、観測した残骸そのものか、保持者が同じく存在しない別の残骸である。
    echo "⚠️  ${hop}（PID ${pid}）のロックが残っていたため引き継ぎます（キー: ${key}）" >&2
    rm -f "$stale" 2>/dev/null || true
    if _lock_link "$lockfile" "$op"; then
        _HELD_LOCK_PATHS+=("$lockfile")
        return 0
    fi
    _lock_busy_message "$key" "" ""
    return 1
}

# _release_lock_path <lockfile>
#   向き先の PID が自分と一致するときだけ削除する（他人のロックを消さない）。冪等。
_release_lock_path() {
    local lockfile="$1" holder pid p rest=()
    holder=$(readlink "$lockfile" 2>/dev/null) || holder=""
    [ -n "$holder" ] || return 0
    pid="${holder%% *}"
    [ "$pid" = "$$" ] || return 0
    rm -f "$lockfile" 2>/dev/null || true
    # 明示解放したキーは trap 用の配列から外す（外さないと、後から別の操作が同じキーを
    # 取り直した場合に、こちらの終了時の trap が他人のロックを消す）。
    for p in "${_HELD_LOCK_PATHS[@]}"; do
        [ "$p" = "$lockfile" ] || rest+=("$p")
    done
    _HELD_LOCK_PATHS=("${rest[@]}")
}

# release_lock <key> <種別: project|shared>
release_lock() {
    _release_lock_path "$(_lock_path "$1" "${2:-project}")"
}

# =============================================================================
# 破壊的操作の対象の識別（CTR-cli-container）
# =============================================================================
# 文字列の SHA-256 を 16 進小文字で返す（Linux=sha256sum / macOS=shasum -a 256。
# 同じ入力に対して両 OS で同じ値になる）
sha256_hex() {
    if command -v sha256sum >/dev/null 2>&1; then
        printf '%s' "$1" | sha256sum | cut -d' ' -f1
    else
        printf '%s' "$1" | shasum -a 256 | cut -d' ' -f1
    fi
}

# compose プロジェクト名（本要件より前の形式。別ディレクトリと衝突しうるので削除対象にしない）
compose_project_name_legacy() {
    printf '%s' "$1" | tr '[:upper:]' '[:lower:]' | sed 's/[^a-z0-9_-]/-/g'
}

# compose プロジェクト名の一意化名 <正規化名>-<起動ディレクトリ絶対パスの SHA-256 先頭6桁>
#   compose 資源にはホスト CLI のラベルが届かないため、名前そのものを一意にする（DSN-env-03）。
#   start が COMPOSE_PROJECT_NAME として渡す値と stop が再計算する値は必ずこの 1 関数を通す。
compose_project_name() {
    printf '%s-%s' "$(compose_project_name_legacy "$1")" "$(sha256_hex "$2" | cut -c1-6)"
}

# 管理ラベル claude-dev.project-dir の値（起動時のホスト側の絶対パス）を返す。
# ラベルが無い、またはコンテナが存在しない場合は空を返す。
# stop はこの値を compose 一意化名のハッシュ源に使うため、本体を削除する「前」に読む。
container_project_dir() {
    local v
    v=$(docker inspect "$1" --format '{{index .Config.Labels "claude-dev.project-dir"}}' 2>/dev/null) || return 0
    case "$v" in "<no value>") v="" ;; esac
    printf '%s' "$v"
}

# 管理ラベル claude-dev.managed=1 を持つか（本システムが作った Claude コンテナか）
container_is_managed() {
    local v
    v=$(docker inspect "$1" --format '{{index .Config.Labels "claude-dev.managed"}}' 2>/dev/null) || return 1
    [ "$v" = "1" ]
}

# セッション由来の資源（docker-proxy が所有者ラベルを付けたコンテナ・ネットワーク）を
# 名前で列挙する（DSN-env-04 の規則D）。
#   spawned_resources <container|network> <ラベルフィルタ式>
#   例: spawned_resources container "claude-dev.owner-project-dir=/home/u/app"
#       spawned_resources network   "claude-dev.role=spawned"
#
#   **--format で名前だけを取る**。既定の表形式はヘッダ行を含み、-q は ID を返すので、
#   どちらもそのままでは表示にも docker rm にも使えない。
#   **問い合わせ自体に失敗したら非 0 を返す**。0 件（消すものが無い）と
#   引けなかったことを同一視してはならない（CTR-cli-container「エラーケース」）。
spawned_resources() {
    case "$1" in
        container) docker ps -a --filter "label=$2" --format '{{.Names}}' 2>/dev/null ;;
        network)   docker network ls --filter "label=$2" --format '{{.Name}}' 2>/dev/null ;;
        *)         return 2 ;;
    esac
}

# 遊休判定に使う集合を求める（CTR-cli-container「遊休判定」）。
#   claude-dev-net に接続している稼働中コンテナから、固定名 claude-dev-docker-proxy と
#   固定接頭辞 fwd- のものを除いた名前を 1 行ずつ出力する。空なら遊休。
#   イメージ（--filter ancestor）にもラベルにも依存しない: どちらも「数え落とす」方向に
#   外れるため（docs/issues/045 / 本変更前に起動した既存コンテナ）。
#   Docker への問い合わせに失敗したら非 0 を返す（呼び出し元は遊休でないと判定する）。
net_other_running_containers() {
    local attached running name
    attached=$(docker network inspect "$NETWORK" --format '{{range .Containers}}{{println .Name}}{{end}}' 2>/dev/null) || return 1
    running=$(docker ps --format '{{.Names}}' 2>/dev/null) || return 1
    while IFS= read -r name; do
        [ -n "$name" ] || continue
        [ "$name" = "$DOCKER_PROXY_CONTAINER" ] && continue
        case "$name" in fwd-*) continue ;; esac
        printf '%s\n' "$running" | grep -qxF "$name" || continue
        printf '%s\n' "$name"
    done <<< "$attached"
}

# 遊休なら Docker Proxy コンテナを停止する（判定は上の集合で行う）
stop_proxy_if_idle() {
    local others
    if ! others=$(net_other_running_containers); then
        echo "⚠️  遊休判定に必要な Docker への問い合わせに失敗しました。安全側に倒して Docker Socket Proxy コンテナを残します。"
        return 0
    fi
    if [ -n "$others" ]; then
        echo "🐳 ${NETWORK} に接続している稼働中のコンテナが残っているため Docker Socket Proxy コンテナを残します:"
        printf '%s\n' "$others" | sed 's/^/   - /'
        return 0
    fi
    if is_running "$DOCKER_PROXY_CONTAINER"; then
        docker rm -f "$DOCKER_PROXY_CONTAINER" >/dev/null
        echo "🐳 Docker Socket Proxy コンテナを停止しました（Claude コンテナなし）"
    fi
}

# =============================================================================
# 破壊的操作の削除結果の記録（logout / reset で共有。D0-env-08 項5）
# =============================================================================
# 削除に失敗した資源がある状態で成功の文言を出さないため、1 件ごとに成否を記録する。
_DESTRUCTIVE_PENDING=()      # 削除予定（未着手）
_DESTRUCTIVE_DELETED=()      # 削除できた
_DESTRUCTIVE_FAILED=()       # 削除できなかった
_DESTRUCTIVE_INTERRUPTED=0

destructive_plan() { _DESTRUCTIVE_PENDING+=("$1"); }

_destructive_done() {
    local k rest=()
    for k in "${_DESTRUCTIVE_PENDING[@]}"; do
        [ "$k" = "$1" ] || rest+=("$k")
    done
    _DESTRUCTIVE_PENDING=("${rest[@]}")
}

destructive_deleted() { _destructive_done "$1"; _DESTRUCTIVE_DELETED+=("$1"); }
destructive_failed()  { _destructive_done "$1"; _DESTRUCTIVE_FAILED+=("$1"); }
# 「削除しないと決めたもの」。失敗には数えない（意図した結果である）
destructive_skipped() { _destructive_done "$1"; }

# destructive_rm <表示名> <コマンド...>
#   **削除コマンドはサブシェルで INT / TERM を無視させてから起動する。** 非対話シェルでは
#   ジョブ制御が無効で子プロセスがシェルと同じプロセスグループに入るため、端末で Ctrl-C を
#   押すと docker にも SIGINT が直接届き、「進行中の 1 件を終えてから中断する」が成立しない。
#   `trap '' INT TERM` が設定する SIG_IGN は exec した子へ継承されるので、docker 自身が
#   シグナルを無視して削除を完了する（両 OS で同じ形に書ける）。
destructive_rm() {
    local label="$1"
    shift
    if ( trap '' INT TERM; "$@" ) >/dev/null 2>&1; then
        destructive_deleted "$label"
    else
        destructive_failed "$label"
    fi
}

destructive_report() {
    local x
    echo "   削除した資源:"
    if [ ${#_DESTRUCTIVE_DELETED[@]} -gt 0 ]; then
        for x in "${_DESTRUCTIVE_DELETED[@]}"; do echo "     - $x"; done
    else
        echo "     （なし）"
    fi
    if [ ${#_DESTRUCTIVE_FAILED[@]} -gt 0 ] || [ ${#_DESTRUCTIVE_PENDING[@]} -gt 0 ]; then
        echo "   削除できなかった / 未削除のまま残った資源:"
        for x in "${_DESTRUCTIVE_FAILED[@]}"; do echo "     - $x"; done
        for x in "${_DESTRUCTIVE_PENDING[@]}"; do echo "     - $x（未着手）"; done
    fi
}

# INT / TERM を遅延させる（進行中の 1 件を途中で切ると、より中途半端な状態が残るため）。
# ロックの trap を上書きするが、EXIT の trap は残るのでロックは解放される。
destructive_arm_interrupt() {
    _DESTRUCTIVE_INTERRUPTED=0
    trap '_DESTRUCTIVE_INTERRUPTED=1' INT TERM
}

# 中断要求が来ていたら、そこまでの削除結果を列挙して終了コード 130 で終わる
destructive_abort_if_interrupted() {
    [ "$_DESTRUCTIVE_INTERRUPTED" = "1" ] || return 0
    echo "" >&2
    echo "⛔ 中断しました（進行中の 1 件を終えてから停止しました）。" >&2
    destructive_report >&2
    exit 130
}

# Docker Socket Proxy 共有コンテナを起動（未起動の場合のみ）
ensure_docker_proxy_container() {
    # Docker ソケットがなければスキップ
    local sock
    sock=$(detect_docker_sock)
    if [ -z "$sock" ]; then
        return 0
    fi

    # イメージがなければビルド
    if ! image_exists "$IMG_DOCKER_PROXY"; then
        echo "📦 Docker Socket Proxy イメージが見つかりません。ビルドします..."
        docker build -t "$IMG_DOCKER_PROXY" \
            -f "${BASE_DIR}/.devcontainer/Dockerfile.docker-proxy" "$BASE_DIR"
    fi

    # 既に実行中なら何もしない
    if is_running "$DOCKER_PROXY_CONTAINER"; then
        return 0
    fi

    # 停止中のコンテナがあれば削除
    if container_exists "$DOCKER_PROXY_CONTAINER"; then
        docker rm -f "$DOCKER_PROXY_CONTAINER" >/dev/null
    fi

    # /workspace 配下 bind の許可（既定有効・docs/03 §5 / docs/impl/50）。
    # 無効化は host 環境で CLAUDE_DEV_ALLOW_WORKSPACE_BINDS=0 を設定し proxy を作り直す。
    docker run -d \
        --name "$DOCKER_PROXY_CONTAINER" \
        --hostname "$DOCKER_PROXY_CONTAINER" \
        --network "$NETWORK" \
        --restart unless-stopped \
        -e "CLAUDE_DEV_ALLOW_WORKSPACE_BINDS=${CLAUDE_DEV_ALLOW_WORKSPACE_BINDS:-1}" \
        -v "${sock}:/var/run/docker.sock:ro" \
        "$IMG_DOCKER_PROXY" >/dev/null

    echo "🐳 Docker Socket Proxy コンテナ起動"
}

# =============================================================================
# コマンド
# =============================================================================
case "${1:-help}" in

# -----------------------------------------------------------------------------
# 初回セットアップ
# -----------------------------------------------------------------------------
setup)
    echo "🚀 Claude Code 開発環境セットアップ（macOS）"
    echo ""

    # .env
    if [ ! -f "${BASE_DIR}/.env" ]; then
        cp "${BASE_DIR}/.env.example" "${BASE_DIR}/.env"
        echo "✅ .env を作成しました（必要に応じて ${BASE_DIR}/.env を編集）"
    else
        echo "ℹ️  .env は既に存在します"
    fi

    # ネットワーク
    docker network create "$NETWORK" 2>/dev/null || true
    echo "✅ ネットワーク: $NETWORK"

    # ボリューム
    docker volume create "$VOL_AUTH" >/dev/null 2>&1 || true
    docker volume create "$VOL_HISTORY" >/dev/null 2>&1 || true
    docker volume create "$VOL_CONFIG" >/dev/null 2>&1 || true
    # Chrome プロファイルはコンテナごとのボリューム（起動時に docker run が自動作成）
    echo "✅ ボリューム: $VOL_AUTH, $VOL_HISTORY, $VOL_CONFIG"

    # Claude ベースイメージビルド
    echo ""
    echo "📦 Claude ベースイメージをビルド中... (user: $CUSER)"
    docker build -t "$IMG_CLAUDE" \
        --target claude-cli \
        --build-arg USERNAME="$CUSER" \
        --build-arg USER_UID="$(id -u)" \
        --build-arg USER_GID="$(id -g)" \
        -f "${BASE_DIR}/.devcontainer/Dockerfile.claude" "$BASE_DIR"
    echo "✅ Claude ベースイメージビルド完了"

    # Claude VNC イメージビルド
    echo ""
    echo "📦 Claude VNC イメージをビルド中..."
    docker build -t "$IMG_CLAUDE_VNC" \
        --target claude-vnc \
        --build-arg USERNAME="$CUSER" \
        --build-arg USER_UID="$(id -u)" \
        --build-arg USER_GID="$(id -g)" \
        -f "${BASE_DIR}/.devcontainer/Dockerfile.claude" "$BASE_DIR"
    echo "✅ Claude VNC イメージビルド完了"

    # Docker Socket Proxy イメージビルド
    echo ""
    echo "📦 Docker Socket Proxy イメージをビルド中..."
    docker build -t "$IMG_DOCKER_PROXY" \
        -f "${BASE_DIR}/.devcontainer/Dockerfile.docker-proxy" "$BASE_DIR"
    echo "✅ Docker Socket Proxy イメージビルド完了"

    echo ""
    echo "============================================"
    echo "✅ セットアップ完了！"
    echo ""
    echo "次のステップ:"
    echo "  1. claude-dev login          # Claude（codex も使うなら claude-dev login-codex）"
    echo "  2. cd /path/to/your/project"
    echo "  3. claude-dev start"
    echo ""
    if ! command -v claude-dev >/dev/null 2>&1; then
        echo "PATH に追加:"
        echo "  make install   # OS を判定し claude-dev-mac を /usr/local/bin/claude-dev へ symlink（sudo）"
        echo "  # 手動の場合: sudo ln -sf ${BASE_DIR}/claude-dev-mac /usr/local/bin/claude-dev"
    fi
    echo "============================================"
    ;;

# -----------------------------------------------------------------------------
# OAuth ログイン
# -----------------------------------------------------------------------------
login)
    require_setup
    ensure_infrastructure
    # 共有ボリュームへ認証を「書く」唯一の経路なので共有資源単位のロックを取る。
    # require_setup / ensure_infrastructure は冪等な共有資源の準備でロックの保護対象外
    # （CTR-cli-container「排他（ロックキー）」）なので、その後に取る。
    # 対話認証の全区間で保持する（書き込みは対話の終了後なので、前後で取り直すと窓が開く）。
    acquire_lock shared login shared || exit 1
    echo "📋 Claude OAuth ログイン"
    echo ""
    echo "Claude Code が起動します。ログインを完了してから /exit で終了してください。"
    echo ""

    # claude-dev-auth ボリュームを ~/.claude-shared にマウント
    # 認証ファイル（.credentials.json, .claude.json）だけを共有ボリュームに永続化
    # settings.json は共有しない（コンテナごとに独立管理）
    docker run --rm -it \
        --network "$NETWORK" \
        --entrypoint bash \
        -e "TERM=${TERM:-xterm-256color}" \
        -e "LANG=en_US.UTF-8" \
        -e "CUSER=$CUSER" \
        -e "CHOME=$CHOME" \
        -v "${VOL_AUTH}:${CHOME}/.claude-shared" \
        "$IMG_CLAUDE" \
        -c '
            chown -R "$CUSER":"$CUSER" "$CHOME/.claude-shared" 2>/dev/null || true
            mkdir -p "$CHOME/.claude"
            chown "$CUSER":"$CUSER" "$CHOME/.claude"

            # settings.json はローカルに作成（共有しない）
            # この -c スクリプト全体がホスト側でシングルクォートに括られているため、
            # 内部でシングルクォートを使うと外側の引用が閉じて JSON が壊れる（ブレース展開）
            if [ ! -f "$CHOME/.claude/settings.json" ]; then
                echo "{\"permissions\":{\"defaultMode\":\"bypassPermissions\"},\"model\":\"sonnet\"}" > "$CHOME/.claude/settings.json"
                chown "$CUSER":"$CUSER" "$CHOME/.claude/settings.json"
            fi

            su "$CUSER" -s /bin/bash -l -c "
                # 共有ボリュームに認証情報があれば ~/.claude/ にコピー
                for f in .credentials.json .claude.json; do
                    if [ -f ~/.claude-shared/\$f ]; then
                        cp ~/.claude-shared/\$f ~/.claude/\$f
                    fi
                done
                # ~/.claude.json（ホーム直下）へのリンク
                if [ -f ~/.claude/.claude.json ]; then
                    ln -sf ~/.claude/.claude.json ~/.claude.json
                fi

                claude || true

                # login 後: 認証ファイルを共有ボリュームに永続化
                for f in .credentials.json .claude.json; do
                    src=~/.claude/\$f
                    dst=~/.claude-shared/\$f
                    if [ -f \"\$src\" ]; then
                        cp \"\$src\" \"\$dst\"
                    fi
                done
                # ホーム直下の .claude.json も確認
                if [ -f ~/.claude.json ] && [ ! -L ~/.claude.json ]; then
                    cp ~/.claude.json ~/.claude-shared/.claude.json
                fi
            "
        '

    release_lock shared shared
    echo "✅ ログイン処理完了"
    ;;

# -----------------------------------------------------------------------------
# Codex デバイス認証ログイン（D-27）
#   codex の認証は $CODEX_HOME/auth.json（既定 ~/.codex/auth.json）のみを共有する。
#   claude と同じ claude-dev-auth ボリュームの codex/ サブディレクトリに相乗りさせるため、
#   ボリューム・logout・reset の分岐は増えない。実装は Linux 版と同一（OS 差分なし）。
# -----------------------------------------------------------------------------
login-codex)
    require_setup
    ensure_infrastructure
    # 共有ボリュームの codex/ へ認証を書く経路。login と同じキーを使う（claude と codex の
    # 認証は同じボリュームに同居するため。キーを分けると排他が成立しない）。
    # デバイス認証の全区間で保持する。
    acquire_lock shared login-codex shared || exit 1
    echo "📋 Codex デバイス認証ログイン"
    echo ""
    echo "codex が認証 URL と認証コードを表示します。ブラウザで開いて認証を完了し、"
    echo "その後 codex を終了してください。"
    echo ""

    docker run --rm -it \
        --network "$NETWORK" \
        --entrypoint bash \
        -e "TERM=${TERM:-xterm-256color}" \
        -e "LANG=en_US.UTF-8" \
        -e "CUSER=$CUSER" \
        -e "CHOME=$CHOME" \
        -v "${VOL_AUTH}:${CHOME}/.claude-shared" \
        "$IMG_CLAUDE" \
        -c '
            # 共有側は entrypoint のバックグラウンド同期（root 実行）で root 所有になりうるため、
            # ここで所有権を戻してからユーザー権限で読み書きする（login と同じ流儀）
            mkdir -p "$CHOME/.claude-shared/codex"
            chown -R "$CUSER":"$CUSER" "$CHOME/.claude-shared" 2>/dev/null || true
            rm -rf "$CHOME/.codex"
            mkdir -p "$CHOME/.codex"
            chown "$CUSER":"$CUSER" "$CHOME/.codex"

            su "$CUSER" -s /bin/bash -l -c "
                # 既存の認証があれば引き継ぐ（再ログインで別アカウントに変える場合も上書きされる）
                if [ -f ~/.claude-shared/codex/auth.json ]; then
                    cp ~/.claude-shared/codex/auth.json ~/.codex/auth.json
                    chmod 600 ~/.codex/auth.json
                fi

                codex login --device-auth || true

                # ログイン後: 認証ファイルを共有ボリュームに永続化
                if [ -f ~/.codex/auth.json ]; then
                    cp ~/.codex/auth.json ~/.claude-shared/codex/auth.json
                    chmod 600 ~/.claude-shared/codex/auth.json
                fi
            "
        '

    release_lock shared shared
    echo "✅ Codex ログイン処理完了"
    echo "   次回以降の claude-dev start で全プロジェクトのコンテナに共有されます"
    ;;

# -----------------------------------------------------------------------------
# ログイン情報削除
# -----------------------------------------------------------------------------
logout)
    # 引数解析（--yes のみ。それ以外は無視する）
    _yes=0
    for _a in "$@"; do [ "$_a" = "--yes" ] && _yes=1; done

    require_setup
    # 共有ボリュームを空にする操作なので共有資源単位のロックを取る。取れなければ
    # 何も削除しない（start の認証コピーと重なると認証が空のまま起動する = issue 020）
    acquire_lock shared logout shared || exit 1

    # --- 削除対象の列挙（CTR-cli-container 規則A）---
    # Claude コンテナは管理ラベルを持つものだけ。イメージからの逆引きは使わない
    # （イメージ更新前に起動したコンテナを取りこぼし、他人の資源を巻き込むため）。
    _targets=()
    while IFS= read -r _c; do
        [ -n "$_c" ] && _targets+=("$_c")
    done < <(docker ps -a --filter "label=claude-dev.managed=1" --format '{{.Names}}' 2>/dev/null || true)

    # 管理ラベルを持たない Claude コンテナ（削除しない。名前を表示して残す）。
    # ラベルが無いのでラベルでは引けない。遊休判定と同じ集合の求め方を使う。
    _unmanaged=()
    _idle_query_ok=1
    if _others=$(net_other_running_containers); then
        while IFS= read -r _c; do
            [ -n "$_c" ] || continue
            _known=0
            for _t in "${_targets[@]}"; do [ "$_t" = "$_c" ] && _known=1; done
            [ "$_known" = "0" ] && _unmanaged+=("$_c")
        done <<< "$_others"
    else
        _idle_query_ok=0
    fi

    # カレントディレクトリのプロジェクト配下にコピーされた認証（3ファイルだけ）。
    # ディレクトリと settings.json / host-hooks.json は認証ではないので消さない。
    _authfiles=()
    for _f in "$(pwd)/.claude/.credentials.json" "$(pwd)/.claude/.claude.json" "$(pwd)/.codex/auth.json"; do
        [ -f "$_f" ] && _authfiles+=("$_f")
    done

    # 共有ボリュームが「空であることを確認できた」か（削除対象0件の判定に使う）。
    # 判定は3条件の論理積である（FR-env-03 受入基準19 / CTR-cli-container のエラーケース）:
    #   (i) 印 __CLAUDE_DEV_AUTH_LISTED__ が出ている（＝一時コンテナが起動できた）
    #   (ii) 一時コンテナの終了ステータスが 0（＝列挙そのものが成功した）
    #   (iii) 印以外の行が1つも無い
    # 1つでも欠ければ「空」と判定しない（daemon 断・イメージ欠落・マウント不能・権限）。
    # 手順10 が rm -rf の終了コードを見ないのは . と .. で非0を返しうるためで、ここは
    # 列挙しか行わないので終了ステータスが「列挙できたか」をそのまま表す。
    _auth_empty=0
    _auth_probe_ok=1
    _auth_probe=$( ( trap '' INT TERM; docker run --rm --entrypoint bash \
        -v "${VOL_AUTH}:/auth" \
        "$IMG_CLAUDE" \
        -c 'echo "__CLAUDE_DEV_AUTH_LISTED__"; ls -A /auth' ) 2>/dev/null ) \
        && _auth_probe_status=0 || _auth_probe_status=$?
    if [ "$_auth_probe_status" != "0" ] \
        || ! printf '%s\n' "$_auth_probe" | grep -qxF '__CLAUDE_DEV_AUTH_LISTED__'; then
        _auth_probe_ok=0
    else
        # grep -v は一致行が無いとき（＝印だけ＝ボリュームが空）に 1 を返すので || true が要る
        _auth_probe_left=$(printf '%s\n' "$_auth_probe" | grep -vxF '__CLAUDE_DEV_AUTH_LISTED__' || true)
        [ -z "$_auth_probe_left" ] && _auth_empty=1
    fi

    # 削除対象が0件なら確認を求めない（消すものが無いのに確認を求めると誤解させる）。
    # 共有ボリュームは「空であることを確認できた」ときだけ0件に数える（受入基準19）。
    if [ ${#_targets[@]} -eq 0 ] && [ ${#_authfiles[@]} -eq 0 ] && [ "$_auth_empty" = "1" ]; then
        echo "ℹ️  削除対象がありません（管理ラベルを持つコンテナ・共有ボリュームの認証・"
        echo "   カレントディレクトリの認証コピーのいずれも見つかりませんでした）"
        exit 0
    fi

    # 空かどうかを確かめられなかったときは「空だった」と読み替えず、削除対象の列挙と
    # 確認を経て削除へ進む（FR-env-03 受入基準19 / CTR-cli-container のエラーケース）
    if [ "$_auth_probe_ok" = "0" ]; then
        echo "⚠️  共有ボリューム ${VOL_AUTH} が空かどうかを確認できませんでした（中身を読む一時コンテナを起動できなかったか、列挙そのものが失敗しました）。"
        echo "   「空だった」とは判定しません。削除対象を列挙して確認を求めます。"
    fi

    # --- 確認 ---
    if [ "$_yes" != "1" ]; then
        if [ ! -t 0 ]; then
            echo "❌ 端末が無いため確認を求められません。何も削除していません。" >&2
            echo "   確認なしで実行するには 'claude-dev logout --yes' を指定してください。" >&2
            exit 1
        fi
        echo "⚠️  以下を削除します:"
        for _t in "${_targets[@]}"; do echo "   - コンテナ: ${_t}"; done
        for _f in "${_authfiles[@]}"; do echo "   - ファイル: ${_f}"; done
        echo "   - 共有ボリューム ${VOL_AUTH} の認証情報（Claude Code と Codex CLI の両方が消えます）"
        if [ ${#_unmanaged[@]} -gt 0 ]; then
            echo "   （管理ラベルを持たない次のコンテナは削除しません: ${_unmanaged[*]}）"
        fi
        echo ""
        read -p "実行しますか？ (y/N) " -n 1 -r
        echo
        if [[ ! $REPLY =~ ^[Yy]$ ]]; then
            echo "キャンセルしました"
            exit 0
        fi
    fi

    # --- 削除 ---
    echo "🗑️  認証情報を削除中..."
    for _t in "${_targets[@]}"; do destructive_plan "コンテナ: ${_t}"; done
    for _f in "${_authfiles[@]}"; do destructive_plan "ファイル: ${_f}"; done
    destructive_plan "Docker Socket Proxy コンテナ"
    destructive_plan "共有ボリューム ${VOL_AUTH} の認証情報"
    # ここから先は INT / TERM を遅延させる（1件の削除を途中で切ると、より中途半端になる）
    destructive_arm_interrupt

    for _t in "${_targets[@]}"; do
        destructive_abort_if_interrupted
        if container_exists "$_t"; then
            destructive_rm "コンテナ: ${_t}" docker rm -f "$_t"
        else
            destructive_skipped "コンテナ: ${_t}"   # 既に消えている。失敗には数えない
        fi
    done
    destructive_abort_if_interrupted

    # docker-proxy は遊休判定を通してから消す。管理ラベルを持たない既存コンテナを
    # 残しているため、この判定は空にならないことがある（FR-env-01 受入基準9）。
    if _others=$(net_other_running_containers); then
        if [ -n "$_others" ]; then
            echo "🐳 ${NETWORK} に接続している稼働中のコンテナが残っているため Docker Socket Proxy コンテナを残します:"
            printf '%s\n' "$_others" | sed 's/^/   - /'
            destructive_skipped "Docker Socket Proxy コンテナ"
        elif container_exists "$DOCKER_PROXY_CONTAINER"; then
            destructive_rm "Docker Socket Proxy コンテナ" docker rm -f "$DOCKER_PROXY_CONTAINER"
        else
            destructive_skipped "Docker Socket Proxy コンテナ"
        fi
    else
        echo "⚠️  遊休判定に必要な Docker への問い合わせに失敗しました。安全側に倒して Docker Socket Proxy コンテナを残します。"
        destructive_skipped "Docker Socket Proxy コンテナ"
    fi
    destructive_abort_if_interrupted

    for _f in "${_authfiles[@]}"; do
        destructive_abort_if_interrupted
        destructive_rm "ファイル: ${_f}" rm -f "$_f"
    done
    destructive_abort_if_interrupted

    # 共有ボリュームを空にする。成否は「削除後の列挙結果」だけで判定し、rm -rf の
    # 終了コードでは判定しない（rm -rf /auth/* /auth/.* は . と .. に当たって非0を
    # 返しうる一方、通常のファイルは消えているため、終了コードは「消えたか」を表さない）。
    # 一時コンテナ自体が起動できなかった場合（daemon 断・イメージ欠落・マウント不能）と
    # 「消去に成功して空になった」場合は、どちらも出力が空になって区別できない。
    # 列挙の直前に印を出させ、印が無ければ「削除できなかった」と判定する。
    _auth_out=$( ( trap '' INT TERM; docker run --rm --entrypoint bash \
        -v "${VOL_AUTH}:/auth" \
        "$IMG_CLAUDE" \
        -c 'rm -rf /auth/* /auth/.* >/dev/null 2>&1; echo "__CLAUDE_DEV_AUTH_LISTED__"; ls -A /auth 2>/dev/null' ) 2>/dev/null || true)
    if ! printf '%s\n' "$_auth_out" | grep -qxF '__CLAUDE_DEV_AUTH_LISTED__'; then
        echo "❌ 共有ボリューム ${VOL_AUTH} の消去を確認できませんでした（一時コンテナを起動できていません）。" >&2
        destructive_failed "共有ボリューム ${VOL_AUTH} の認証情報（消去を確認できず）"
        _auth_left=""
    else
        # grep -v は一致行が無いとき（＝印だけ＝ボリュームが空）に 1 を返すので || true が要る
        _auth_left=$(printf '%s\n' "$_auth_out" | grep -vxF '__CLAUDE_DEV_AUTH_LISTED__' || true)
    fi
    if [ -n "$_auth_left" ]; then
        destructive_skipped "共有ボリューム ${VOL_AUTH} の認証情報"
        while IFS= read -r _p; do
            [ -n "$_p" ] && destructive_failed "共有ボリューム ${VOL_AUTH} 内: /auth/${_p}"
        done <<< "$_auth_left"
    else
        destructive_deleted "共有ボリューム ${VOL_AUTH} の認証情報"
    fi

    destructive_abort_if_interrupted

    # --- 結果 ---
    if [ ${#_DESTRUCTIVE_FAILED[@]} -gt 0 ]; then
        echo "❌ 削除できなかった資源があります。" >&2
        destructive_report >&2
        exit 1
    fi
    echo "✅ 認証情報を削除しました"
    destructive_report
    if [ ${#_unmanaged[@]} -gt 0 ]; then
        echo "ℹ️  管理ラベルを持たないため削除しなかったコンテナ（本変更より前に起動した可能性があります）:"
        for _c in "${_unmanaged[@]}"; do echo "     - ${_c}"; done
        echo "   1件ずつ止めるには 'claude-dev stop <name>' を使ってください。"
        echo "   停止中のものは列挙していません（ネットワークの接続情報からは稼働中しか分かりません）。"
        echo "⚠️  これらのコンテナは 30 秒ごとに認証を共有ボリュームへ書き戻すため、"
        echo "   稼働したままだと共有ボリュームの認証が復活します。完全に消すには、"
        echo "   'claude-dev stop <name>' で止めてから 'claude-dev logout' を実行し直してください。"
    elif [ "$_idle_query_ok" = "0" ]; then
        echo "ℹ️  ${NETWORK} への問い合わせに失敗したため、管理ラベルを持たないコンテナの列挙はできませんでした。"
    fi
    if [ ${#_authfiles[@]} -gt 0 ]; then
        echo "ℹ️  他のディレクトリにコピーされた認証には触れていません（本システムはその場所を記録していません）。"
    fi
    echo "   再ログイン: claude-dev login / claude-dev login-codex"
    release_lock shared shared
    ;;

# -----------------------------------------------------------------------------
# GHCR からイメージを取得してローカル名に retag（ビルドの代わりに使う）
#   claude-dev pull [TAG]
#   .env の CLAUDE_DEV_REGISTRY（既定 ghcr.io/quvox）/ CLAUDE_DEV_IMAGE_TAG（既定 latest）を参照。
#   引数 TAG で latest 以外（YYYYMMDDHHmm）に固定できる。
# -----------------------------------------------------------------------------
pull)
    REG="${CLAUDE_DEV_REGISTRY:-ghcr.io/quvox}"
    TAG="${2:-${CLAUDE_DEV_IMAGE_TAG:-latest}}"
    echo "📥 GHCR からイメージを取得します: ${REG}/{$IMG_CLAUDE,$IMG_CLAUDE_VNC,$IMG_DOCKER_PROXY}:${TAG}"
    _pull_ok=0
    for name in "$IMG_CLAUDE" "$IMG_CLAUDE_VNC" "$IMG_DOCKER_PROXY"; do
        src="${REG}/${name}:${TAG}"
        echo "  - pull ${src}"
        if docker pull "$src"; then
            docker tag "$src" "${name}:latest"
            echo "    → ローカル名 ${name} に retag"
            _pull_ok=1
        else
            echo "    ⚠️  ${src} の取得に失敗（存在しない/未ログイン/権限？）"
        fi
    done
    if [ "$_pull_ok" = "1" ]; then
        echo "✅ pull 完了。'claude-dev start' はこのイメージを使います（再ビルドしません）"
        echo "   固定バージョンは 'claude-dev pull <YYYYMMDDHHmm>' か .env の CLAUDE_DEV_IMAGE_TAG"
    else
        echo "❌ すべての pull に失敗しました。private リポジトリなら 'docker login ghcr.io' が必要です"
        exit 1
    fi
    ;;

# -----------------------------------------------------------------------------
# プロジェクト開始（カレントディレクトリ）
# -----------------------------------------------------------------------------
start)
    check_host_deps
    NAME=$(container_name)
    PROJECT_DIR="$(pwd)"
    # プロジェクト単位のロック（キー = コンテナ名）。名前が確定した直後・最初の副作用
    # （ensure_project_config による .claude-dev.yaml 生成）より前に取る。取れなければ
    # 以降の生成物と Docker コンテナを一切作らずに終わる（FR-env-01 受入基準16）。
    # macOS の --kvm / --vm 早期拒否はこの後に来るが、そこで exit しても trap が解放する。
    acquire_lock "$NAME" start project || exit 1
    ensure_project_config "$PROJECT_DIR"
    shift || true

    # フラグ解析（VM/KVM は macOS 非対応。イメージビルド前に早期拒否する）
    USE_VNC=1
    while [ $# -gt 0 ]; do
        case "$1" in
            --no-vnc) USE_VNC=0 ;;
            --kvm|--vm|--vm-fresh)
                echo "❌ $1 は macOS では利用できません。"
                echo "   macOS/Docker Desktop には /dev/kvm がなく、ネスト仮想化も使えないため VM/KVM モードは非対応です。"
                echo "   Docker を多用する開発は通常起動（Docker Socket Proxy 経由）で行ってください。"
                exit 1
                ;;
        esac
        shift
    done

    require_setup

    # 既に実行中 → attach（tmux セッションがなければ再作成）
    if is_running "$NAME"; then
        echo "✅ ${NAME} は実行中。接続します..."
        _img_id=$(docker inspect --format '{{.Image}}' "$NAME" 2>/dev/null)
        [ -n "$_img_id" ] && echo "🏷️  イメージバージョン: $(image_version "$_img_id")"
        ensure_infrastructure
        _url=$(get_novnc_url "$NAME")
        [ -n "$_url" ] && echo "🖥️  noVNC: $_url"
        CUSER="$(resolve_container_user "$NAME")"   # 稼働中コンテナ側のユーザーで exec する
        if ! docker exec -u "$CUSER" "$NAME" tmux has-session -t main 2>/dev/null; then
            docker exec -u "$CUSER" "$NAME" tmux new-session -d -s main 2>/dev/null || true
            sleep 0.5
        fi
        # アタッチは利用者の対話であり長時間続くので、その前にロックを解放する（手順17 と同じ理由）
        release_lock "$NAME" project
        docker exec -it -u "$CUSER" "$NAME" tmux attach -t main
        exit 0
    fi

    # 停止中のコンテナがあれば削除（稼働中は消さない。上の is_running 判定から
    # ここまでの間に他プロセスが同名コンテナを起動していた場合に備える）
    if container_exists "$NAME" && ! is_running "$NAME"; then
        docker rm -f "$NAME" >/dev/null
    fi

    # インフラ確認
    ensure_infrastructure

    # イメージ選択
    if [ "$USE_VNC" = "1" ]; then
        RUN_IMAGE="$IMG_CLAUDE_VNC"
    else
        RUN_IMAGE="$IMG_CLAUDE"
    fi

    # 共有資源単位のロック。認証コピーの開始からコンテナ作成の確定（ポート競合の再試行
    # ループを抜けたところ）まで保持する。認証コピーの直後に離すと、logout が完走した
    # 直後に作られたコンテナの同期ループが認証を書き戻して logout が静かに巻き戻る。
    # あわせて ensure_docker_proxy_container もこの区間に入るので、stop の遊休判定との
    # 競合も同じロックで防げる（CTR-cli-container「排他（ロックキー）」）。
    if ! acquire_lock shared start shared; then
        echo "   logout / reset / login が同時に走っています。認証が空のままコンテナを起動しないため中止しました。" >&2
        exit 1
    fi

    # 認証ファイルを共有ボリュームから /workspace/.claude/・/workspace/.codex/ にコピー
    # （codex 認証は共有ボリュームの codex/ に置かれる。未ログインなら何もコピーせず起動できる）
    mkdir -p "${PROJECT_DIR}/.claude" "${PROJECT_DIR}/.codex"
    docker run --rm \
        --entrypoint bash \
        -v "${VOL_AUTH}:/auth:ro" \
        -v "${PROJECT_DIR}/.claude:/target" \
        -v "${PROJECT_DIR}/.codex:/target-codex" \
        "$IMG_CLAUDE" -c '
            for f in .credentials.json .claude.json; do
                [ -f "/auth/$f" ] && cp "/auth/$f" "/target/$f"
            done
            for f in auth.json; do
                [ -f "/auth/codex/$f" ] && cp "/auth/codex/$f" "/target-codex/$f"
            done
            chown -R '"$(id -u):$(id -g)"' /target/ /target-codex/
        '

    # ホストの ~/.claude/settings.json から hooks / env 設定を抽出してコピー
    # （ファイル名は歴史的経緯で host-hooks.json のままだが env も含む）
    HOST_SETTINGS="${HOME}/.claude/settings.json"
    if [ -f "$HOST_SETTINGS" ]; then
        _overlay=$(jq -c '{hooks: .hooks, env: .env} | with_entries(select(.value != null))' "$HOST_SETTINGS" 2>/dev/null)
        if [ -n "$_overlay" ] && [ "$_overlay" != "{}" ]; then
            echo "$_overlay" > "${PROJECT_DIR}/.claude/host-hooks.json"
        fi
    fi

    # ホストの ~/.local/bin/ スクリプト（ユーザー独自 hook 用）をコンテナ用にコピー
    # 組み込み hook スクリプト (save_prompt.sh / sendslackmsg.sh) はイメージに焼き込み済みのため
    # ここではコピー対象外。ユーザー独自スクリプトのみ ~/.local/bin/ から運ぶ。
    if [ -d "${HOME}/.local/bin" ] && [ -n "$(ls -A "${HOME}/.local/bin/" 2>/dev/null)" ]; then
        mkdir -p "${PROJECT_DIR}/.claude/host-local-bin"
        cp -a "${HOME}/.local/bin/." "${PROJECT_DIR}/.claude/host-local-bin/"
    fi

    # .gitignore に .claude / .codex が含まれていなければ追加
    if [ -f "${PROJECT_DIR}/.gitignore" ]; then
        for _ig in .claude .codex; do
            if ! grep -qxF "$_ig" "${PROJECT_DIR}/.gitignore" && ! grep -qxF "${_ig}/" "${PROJECT_DIR}/.gitignore"; then
                echo "$_ig" >> "${PROJECT_DIR}/.gitignore"
            fi
        done
    elif [ -d "${PROJECT_DIR}/.git" ]; then
        printf '%s\n%s\n' '.claude' '.codex' > "${PROJECT_DIR}/.gitignore"
    fi

    # ~/.gitconfig があればマウント（読み取り専用）
    GITCONFIG_OPT=""
    if [ -f "${HOME}/.gitconfig" ]; then
        GITCONFIG_OPT="-v ${HOME}/.gitconfig:${CHOME}/.gitconfig:ro"
    fi

    # ~/.config/gh があればマウント（読み取り専用）＝ gh の認証（hosts.yml の oauth トークン）と
    # 設定を共有し、コンテナ内でも gh が認証済みで使える。RO なのでホストの認証は書き換わらない。
    GH_CONFIG_OPT=""
    if [ -d "${HOME}/.config/gh" ]; then
        GH_CONFIG_OPT="-v ${HOME}/.config/gh:${CHOME}/.config/gh:ro"
    fi

    # Docker Socket Proxy 経由で Docker API を利用（生ソケットはマウントしない）
    # macOS/Docker Desktop のソケットは /var/run/docker.sock または ~/.docker/run/docker.sock
    DOCKER_OPTS=""
    if [ -n "$(detect_docker_sock)" ]; then
        ensure_docker_proxy_container
        DOCKER_OPTS="-e DOCKER_HOST=tcp://${DOCKER_PROXY_CONTAINER}:2375"
    fi

    # docker compose プロジェクト名を一意化（全プロジェクトが /workspace にマウントされ
    # 既定名が "workspace" に衝突するのを防ぐ）。DOCKER_HOST と同様に -e で渡し、対話・非対話
    # を問わず全シェル（Claude Code の bash -c 実行含む）と docker exec で有効にする。
    # 値は <正規化名>-<起動ディレクトリ絶対パスの SHA-256 先頭6桁>。正規化だけでは
    # ~/work/My.App と ~/other/my-app が同じ my-app に落ち、一方の stop が他方の compose
    # 資源を消しうる（docs/issues/024）。stop は同じ関数でこの値を再計算する（DSN-env-03）。
    COMPOSE_PROJECT="$(compose_project_name "$NAME" "$PROJECT_DIR")"
    COMPOSE_OPTS="-e COMPOSE_PROJECT_NAME=${COMPOSE_PROJECT}"

    # SSH agent（方式D: claude-dev 専用 agent＋socat TCP ブリッジ。秘密鍵はコンテナに渡さない）
    # macOS の Unix ソケットはコンテナへ直接マウントできず、Docker Desktop 魔法ソケットは
    # 利用者の鍵がある agent を転送しないため、専用 agent を鍵ファイルから構築して転送する。
    SSH_OPTS=""
    # 鍵の解決（ディレクトリ単位）: <PROJECT_DIR>/.claude-dev.yaml の ssh_keys のみを見る
    # （グローバルへのフォールバック・対話選択・自動生成はしない。無ければ 0 件＝SSH 転送なし）
    resolve_ssh_keys_for_start "$PROJECT_DIR"
    _valid_keys=0
    for _k in "${SSH_KEY_LIST[@]}"; do [ -f "$_k" ] && _valid_keys=1; done
    if [ "$_valid_keys" = "1" ]; then
        # プロジェクト（= NAME＝ディレクトリ）ごとに専用 agent + ブリッジを使い、鍵を隔離する
        if ensure_dedicated_agent "$NAME"; then
            _sshport=$(ensure_ssh_bridge "$NAME") || _sshport=""
            if [ -n "$_sshport" ]; then
                SSH_OPTS="-e CLAUDE_DEV_SSH_BRIDGE_PORT=${_sshport}"
                echo "🔑 SSH agent 転送: 127.0.0.1:${_sshport}（専用 agent [$NAME]、鍵 ${#SSH_KEY_LIST[@]} 件 / ${SSH_CONFIG_SOURCE}）"
            fi
        fi
    else
        echo "ℹ️  SSH 鍵が未選択のため SSH agent 転送なしで起動します（'claude-dev ssh-keys' で選択、またはプロジェクト直下に ${PROJECT_CONFIG_NAME} を作成）"
    fi
    # ~/.ssh/known_hosts（読み取り専用、秘密情報なし）
    if [ -f "${HOME}/.ssh/known_hosts" ]; then
        SSH_OPTS="${SSH_OPTS} -v ${HOME}/.ssh/known_hosts:${CHOME}/.ssh/known_hosts:ro"
    fi
    # ~/.ssh/config（エージェント転送用に加工した「一時コピー」を RO マウント。ホストの config は不変）
    # IdentityFile / IdentitiesOnly はコンテナ内に鍵ファイルがないため除去。
    # IdentityAgent はホスト固有の agent パス（例 Strongbox の ~/.strongbox/agent.sock）を指し、
    # コンテナ内では存在せず SSH_AUTH_SOCK（= /tmp/ssh-agent.sock のブリッジ）を上書きして
    # agent を不通にするため必ず除去する。
    if [ -f "${HOME}/.ssh/config" ]; then
        _ssh_config_tmp=$(mktemp /tmp/claude-dev-ssh-config.XXXXXX)
        sed -E '/^[[:space:]]*(IdentityFile|IdentitiesOnly|IdentityAgent)/d' "${HOME}/.ssh/config" > "$_ssh_config_tmp"
        SSH_OPTS="${SSH_OPTS} -v ${_ssh_config_tmp}:${CHOME}/.ssh/config:ro"
    fi

    # noVNC ポート割り当て（VNC ありの場合のみ）
    NOVNC_PORT_OPT=""
    if [ "$USE_VNC" = "1" ]; then
        NOVNC_PORT=$(find_available_novnc_port)
        NOVNC_PORT_OPT="-p ${NOVNC_PORT}:6080 -v ${VOL_CHROME_PREFIX}-${NAME}:${CHOME}/.chrome-profile"
    fi

    # コンテナ起動
    echo "🚀 起動中... [${NAME}] → ${PROJECT_DIR}"
    echo "🏷️  イメージ: ${RUN_IMAGE}  バージョン $(image_version "$RUN_IMAGE")"
    # docker run はポート割り当て競合に備えてリトライする。複数 claude-dev を
    # ほぼ同時に start すると find_available_novnc_port の選定〜-p バインドが競合し、
    # 双方が同じポートを選んで「port is already allocated」で失敗し得る（他プロセスに
    # よる横取りも同様）。失敗時は作成途中コンテナを掃除し、ポート競合かつ VNC 有効なら
    # 別ポートを取り直して再試行する（最大 20 回）。
    _run_attempt=0
    while :; do
        if _run_err=$(docker run -d \
            --name "$NAME" \
            --hostname "$NAME" \
            --network "$NETWORK" \
            --cap-add NET_ADMIN \
            --cap-add NET_RAW \
            --restart unless-stopped \
            --label claude-dev.managed=1 \
            --label claude-dev.role=claude \
            --label "claude-dev.project-dir=${PROJECT_DIR}" \
            -v "${PROJECT_DIR}:/workspace" \
            -v "${VOL_HISTORY}:${CHOME}/.command_history" \
            -v "${VOL_AUTH}:${CHOME}/.claude-shared" \
            -v "${VOL_CONFIG}:${CHOME}/.config-shared" \
            -v "${BASE_DIR}/scripts/tmux.conf:${CHOME}/.tmux.conf:ro" \
            -v "${BASE_DIR}/CLAUDE.md:${CHOME}/CLAUDE.md:ro" \
            $GITCONFIG_OPT \
            $GH_CONFIG_OPT \
            $SSH_OPTS \
            $DOCKER_OPTS \
            $COMPOSE_OPTS \
            $NOVNC_PORT_OPT \
            -e NODE_OPTIONS=--max-old-space-size=4096 \
            -t \
            "$RUN_IMAGE" 2>&1 >/dev/null); then
            break
        fi
        _run_attempt=$((_run_attempt + 1))
        # 名前衝突は「他方の start が先に作った」ことを意味するので、後片付けをしてはならない。
        # 同名の稼働中コンテナは別プロジェクト（basename が同じ別ディレクトリ）の作業中セッションで
        # ありうる（FR-env-01 受入基準12）。
        if printf '%s' "$_run_err" | grep -qiE 'Conflict\.|already in use by container'; then
            if is_running "$NAME"; then
                echo "❌ 同名のコンテナ '$NAME' が既に稼働しているため起動を中止しました。" >&2
                # 管理ラベルがあれば「どのディレクトリで起動されたか」を推測ではなく事実として示す
                _other_dir=$(container_project_dir "$NAME")
                if [ -n "$_other_dir" ]; then
                    echo "   そのコンテナは ${_other_dir} で起動されたものです。" >&2
                else
                    echo "   別ディレクトリの同名プロジェクト（コンテナ名はディレクトリ名から決まります）の可能性があります。" >&2
                fi
                echo "   既存のコンテナには手を触れていません。そのプロジェクトのディレクトリで 'claude-dev start' すると再接続できます。" >&2
                echo "   このディレクトリで起動したい場合は、先に 'claude-dev stop $NAME' を実行してください。" >&2
            else
                echo "❌ 同名のコンテナ '$NAME' が既に存在するため起動を中止しました（停止中）。" >&2
                echo "   'claude-dev stop $NAME' で削除してから再実行してください。" >&2
            fi
            exit 1
        fi
        # 後片付けは対象が稼働中でないときだけ（FR-env-01 受入基準13）
        if ! is_running "$NAME"; then
            docker rm -f "$NAME" >/dev/null 2>&1 || true   # 作成途中コンテナを掃除
        fi
        if [ "$USE_VNC" = "1" ] && [ "$_run_attempt" -le 20 ] \
           && printf '%s' "$_run_err" | grep -qiE "port is already allocated|address already in use|bind for .* failed"; then
            NOVNC_PORT=$(find_available_novnc_port)
            NOVNC_PORT_OPT="-p ${NOVNC_PORT}:6080 -v ${VOL_CHROME_PREFIX}-${NAME}:${CHOME}/.chrome-profile"
            echo "🔁 noVNC ポートが競合したため ${NOVNC_PORT} で再試行します"
            continue
        fi
        echo "❌ コンテナ起動に失敗しました:" >&2
        printf '%s\n' "$_run_err" >&2
        exit 1
    done

    # 共有資源単位のロックはここで解放する（コンテナ作成が確定した＝再試行ループを抜けた）。
    # 再試行の途中で離すと、次の試行で作られるコンテナが保護の外に出る。
    release_lock shared shared

    # tmux 起動を待つ
    for i in $(seq 1 30); do
        if docker exec -u "$CUSER" "$NAME" tmux has-session -t main 2>/dev/null; then
            break
        fi
        sleep 1
    done

    # tmux がまだ上がっていなければ、無言で attach 失敗して終了せず状況を案内する
    if ! docker exec -u "$CUSER" "$NAME" tmux has-session -t main 2>/dev/null; then
        echo "⏳ tmux セッションの起動待ちがタイムアウトしました。'claude-dev start' を再実行してください。"
        exit 0
    fi

    echo "✅ 起動完了（Ctrl-_ D で切断、claude-dev start で再接続）"
    _url=$(get_novnc_url "$NAME")
    [ -n "$_url" ] && echo "🖥️  noVNC: $_url"
    # プロジェクト単位のロックは tmux attach の前に解放する。アタッチ中は利用者が端末を
    # 占有しており、その間ロックを保持すると 'claude-dev stop' が実行できなくなる。
    release_lock "$NAME" project
    docker exec -it -u "$CUSER" "$NAME" tmux attach -t main
    ;;

# -----------------------------------------------------------------------------
# Claude Code を新しい tmux ウィンドウで起動
# -----------------------------------------------------------------------------
code)
    require_setup
    NAME=$(container_name)

    if ! is_running "$NAME"; then
        echo "❌ コンテナが起動していません: claude-dev start を先に実行"
        exit 1
    fi
    CUSER="$(resolve_container_user "$NAME")"   # 稼働中コンテナ側のユーザーで exec する

    docker exec -it -u "$CUSER" "$NAME" tmux new-window -t main "claude"
    docker exec -it -u "$CUSER" "$NAME" tmux attach -t main
    ;;

# -----------------------------------------------------------------------------
# 既存セッションに接続
# -----------------------------------------------------------------------------
attach)
    require_setup
    if [ -n "$2" ]; then
        # 名前指定
        NAME="${2}"
    else
        NAME=$(container_name)
    fi

    if ! is_running "$NAME"; then
        echo "❌ ${NAME} は起動していません"
        echo "   実行中のセッション: claude-dev list"
        exit 1
    fi
    CUSER="$(resolve_container_user "$NAME")"   # 稼働中コンテナ側のユーザーで exec する

    docker exec -it -u "$CUSER" "$NAME" tmux attach -t main
    ;;

# -----------------------------------------------------------------------------
# プロジェクト停止
# -----------------------------------------------------------------------------
stop)
    if [ -n "$2" ]; then
        NAME="${2}"
        # ロックキー（= パス要素）になるので、受理する文字を限る（FR-env-01 受入基準18）。
        # / や .. を含む名前を通すと、ロックのパスが意図したディレクトリの外を指す。
        case "$NAME" in
            *[!A-Za-z0-9._-]*)
                echo "❌ 受理できない文字を含むコンテナ名です: '${NAME}'" >&2
                echo "   受理する文字は [A-Za-z0-9._-] だけです。何も削除していません。" >&2
                exit 1
                ;;
        esac
    else
        NAME=$(container_name)   # 既に [a-z0-9._-] へ正規化済み
    fi

    # プロジェクト単位のロック。取れなければ何も削除しない（FR-env-01 受入基準16）
    acquire_lock "$NAME" stop project || exit 1

    # フォワードコンテナも停止。中継コンテナは本システムが決めた固定接頭辞 fwd- と
    # 対象コンテナ名から名前が一意に決まるので、管理ラベルではなく名前で識別する。
    # xargs -r は GNU 拡張で macOS の xargs には無い（両 OS で同じ成否にするため明示ループ）
    while IFS= read -r _fwd; do
        [ -n "$_fwd" ] && docker rm -f "$_fwd" >/dev/null 2>&1 || true
    done < <(docker ps -a --filter "name=^fwd-${NAME}-" --format '{{.Names}}' 2>/dev/null || true)

    # 本体を削除する「前」に管理ラベルを読む（この順序は固定）。削除するとラベルが失われ、
    # 以降 compose の一意化名（ハッシュ源＝起動ディレクトリの絶対パス）を再現できない。
    _stop_managed=0
    _stop_proj_dir=""
    if container_exists "$NAME"; then
        container_is_managed "$NAME" && _stop_managed=1
        _stop_proj_dir=$(container_project_dir "$NAME")
    fi

    if container_exists "$NAME"; then
        # 本体は名前で1件を指した削除なので、管理ラベルの有無を問わず削除する（規則B）
        docker rm -f "$NAME" >/dev/null
        if [ "$_stop_managed" = "0" ]; then
            echo "ℹ️  ${NAME} は本システムの管理ラベルを持ちません（本変更より前に起動した可能性があります）。名前で指定された1件なので削除しました。"
        fi
        echo "✅ ${NAME} を停止しました"
    else
        echo "ℹ️  ${NAME} は存在しません"
    fi

    # このコンテナ内から起動された docker compose のコンテナ群を片付ける。
    # docker-proxy 経由でホスト daemon 上に作られ、com.docker.compose.project
    # ラベル（起動時の COMPOSE_PROJECT_NAME）を持つため、ホスト側から特定できる。
    # docker compose down 相当: コンテナと当該プロジェクトのデフォルトネットワークを
    # 削除し、名前付きボリューム・共有 claude-dev-net・docker-proxy は残す。
    # 一意化名は start と同じ compose_project_name() で再計算する（DSN-env-03）。
    #
    # 削除できた名前はその場では表示せず、下の 1 つの列挙へ渡す。compose コンテナも
    # 用語集の「セッション由来の資源」であり、経路（compose 名か所有者ラベルか）で
    # 表示を分けると、利用者から見て同じ種類のものが 2 箇所に散る（FR-env-01 受入基準26）。
    _spawned_deleted=()
    _spawned_failed=()
    _cproj_legacy_hint="$(compose_project_name_legacy "$NAME")-<ハッシュ6桁>"
    if [ -n "$_stop_proj_dir" ]; then
        _cproj=$(compose_project_name "$NAME" "$_stop_proj_dir")
        while IFS= read -r _cc; do
            [ -n "$_cc" ] || continue
            if docker rm -f "$_cc" >/dev/null 2>&1; then
                _spawned_deleted+=("コンテナ: ${_cc}")
            else
                _spawned_failed+=("コンテナ: ${_cc}")
            fi
        done < <(docker ps -a --filter "label=com.docker.compose.project=${_cproj}" --format '{{.Names}}' 2>/dev/null || true)
        if docker network rm "${_cproj}_default" >/dev/null 2>&1; then
            _spawned_deleted+=("ネットワーク: ${_cproj}_default")
        fi

        # 手順8: 所有者ラベルでセッション由来の資源を削除する（FR-env-01 受入基準22）。
        #   照合値は手順4 で読んだ claude-dev.project-dir そのもの。docker-proxy は
        #   同じラベルを写して claude-dev.owner-project-dir に入れるので、一致は
        #   構成上の帰結であり検証を要しない（DSN-env-04）。
        #   **順序はコンテナ → ネットワークで固定**（接続中のコンテナが残っていると
        #   docker network rm は必ず失敗する）。
        #   **削除の失敗は握って続行する**（受入基準24。片付けの途中で止まると、
        #   より中途半端な状態が残る）。
        _owner_filter="claude-dev.owner-project-dir=${_stop_proj_dir}"
        if _spawned_c=$(spawned_resources container "$_owner_filter"); then
            while IFS= read -r _sc; do
                [ -n "$_sc" ] || continue
                if docker rm -f "$_sc" >/dev/null 2>&1; then
                    _spawned_deleted+=("コンテナ: ${_sc}")
                else
                    _spawned_failed+=("コンテナ: ${_sc}")
                fi
            done <<< "$_spawned_c"
            # ネットワークはコンテナを消したあとにだけ引く（先に引くと必ず使用中で失敗する）
            if _spawned_n=$(spawned_resources network "$_owner_filter"); then
                while IFS= read -r _sn; do
                    [ -n "$_sn" ] || continue
                    if docker network rm "$_sn" >/dev/null 2>&1; then
                        _spawned_deleted+=("ネットワーク: ${_sn}")
                    else
                        _spawned_failed+=("ネットワーク: ${_sn}")
                    fi
                done <<< "$_spawned_n"
            else
                echo "⚠️  セッション由来のネットワークを引けませんでした（Docker への問い合わせに失敗）。削除を行わずに続行します。" >&2
            fi
        else
            # 0 件ではなく「引けなかった」。推測で削除しない（安全側へ倒す）。
            echo "⚠️  セッション由来の資源を引けませんでした（Docker への問い合わせに失敗）。削除を行わずに続行します。" >&2
        fi
    else
        # ハッシュ源も所有者の照合値も claude-dev.project-dir ラベルにしか無い。推測して
        # 作った名前・値で削除すると別ディレクトリ・別セッションを巻き込む
        # （docs/issues/024 の欠陥そのもの）ので、どちらも行わない。
        echo "ℹ️  compose 資源とセッション由来の資源の片付けは行いませんでした（管理ラベル claude-dev.project-dir を読めないため）。"
        echo "   一意化名のハッシュ源も所有者の照合値もこのラベルにしか無く、推測して削除すると別ディレクトリ・別セッションを巻き込みます。"
        echo "   資源が残っている可能性があります。残っているものは次で確認できます:"
        echo "     docker ps -a --filter label=com.docker.compose.project=${_cproj_legacy_hint}"
        echo "     docker ps -a --filter label=claude-dev.role=spawned"
        echo "   片付けるときは、そのプロジェクトのディレクトリで 'docker compose down' を実行するか、'docker rm -f <名前>' してください。"
    fi

    # 手順8-3: 削除できたセッション由来の資源を種別つきで 1 行ずつ表示する
    # （FR-env-01 受入基準26）。`stop` は削除前の確認を求めない（D0-env-08 項3）ので、
    # この事後の列挙が「何が消えたか」を利用者が知る唯一の観測点である。
    # **0 件なら何も表示しない**（対象が無いことを毎回表示しない。同27）。
    if [ ${#_spawned_deleted[@]} -gt 0 ]; then
        echo "🧹 このセッションが作った資源を削除しました:"
        for _t in "${_spawned_deleted[@]}"; do echo "   - ${_t}"; done
    fi
    if [ ${#_spawned_failed[@]} -gt 0 ]; then
        echo "⚠️  次のセッション由来の資源は削除できませんでした（処理は続行しました。次回の stop が回収します）:" >&2
        for _t in "${_spawned_failed[@]}"; do echo "   - ${_t}" >&2; done
    fi

    # 本要件の一意化より前に起動された compose 資源は旧い名前（ハッシュ無し）を持つ。
    # 旧名は別ディレクトリと衝突しうるため削除対象に含めず、手動の片付け方を案内する。
    _cproj_legacy=$(compose_project_name_legacy "$NAME")
    if [ -n "$(docker ps -aq --filter "label=com.docker.compose.project=${_cproj_legacy}" 2>/dev/null)" ]; then
        echo "ℹ️  旧い名前の compose 資源が残っています（プロジェクト名 ${_cproj_legacy}）。"
        echo "   別ディレクトリの同名プロジェクトと衝突しうるため、自動では削除しません。次で確認してください:"
        echo "     docker ps -a --filter label=com.docker.compose.project=${_cproj_legacy}"
        echo "   片付けるときは、そのプロジェクトのディレクトリで 'docker compose down' を実行してください。"
    fi

    # このプロジェクトの SSH ブリッジを停止（専用 agent は鍵保持のため残す）
    stop_ssh_bridge "$NAME"

    # 共有資源単位のロックを取り、遊休判定と docker-proxy の削除を同一区間で行う
    # （他プロジェクトの start が docker-proxy を作った直後に消す競合を防ぐ）。
    if acquire_lock shared stop shared; then
        stop_proxy_if_idle
        release_lock shared shared
    else
        echo "ℹ️  他の操作が共有資源を使用中のため、docker-proxy には触れていません（次回の stop が回収します）。"
    fi
    release_lock "$NAME" project
    ;;

# -----------------------------------------------------------------------------
# SSH 鍵の選択（対話）/ 初期化（対象はカレントプロジェクト）
#   claude-dev ssh-keys          鍵を対話選択して ./.claude-dev.yaml に保存
#   claude-dev ssh-keys reset    このプロジェクトの選択を初期化（./.claude-dev.yaml の ssh_keys 除去＋専用 agent/ブリッジ停止）
# -----------------------------------------------------------------------------
ssh-keys)
    case "${2:-}" in
        reset)
            # カレントプロジェクトの .claude-dev.yaml から ssh_keys セクションを除去
            # （他の記述は残す。ssh_keys だけになれば空になるのでファイルごと削除）
            NAME=$(container_name)
            _proj_config="$(pwd)/${PROJECT_CONFIG_NAME}"
            if [ -f "$_proj_config" ]; then
                _tmp=$(mktemp)
                grep -vE '^ssh_keys:|^[[:space:]]*-[[:space:]]|^# claude-dev プロジェクト設定|^# 再選択は' "$_proj_config" > "$_tmp" 2>/dev/null || true
                if grep -qE '[^[:space:]]' "$_tmp" 2>/dev/null; then mv "$_tmp" "$_proj_config"; else rm -f "$_tmp" "$_proj_config"; fi
            fi
            # このプロジェクトの専用 agent／ブリッジを停止・削除
            for _kind in bpid pid; do
                _f=$(dev_agent_path "$NAME" "$_kind")
                [ -f "$_f" ] && kill "$(cat "$_f" 2>/dev/null)" 2>/dev/null || true
            done
            # sock はディレクトリ残骸（Docker が bind-mount ソースとして作ったもの）のことがあるので -r 付き
            rm -rf "$(dev_agent_path "$NAME" sock)" 2>/dev/null || true
            rm -f "$(dev_agent_path "$NAME" pid)" \
                  "$(dev_agent_path "$NAME" bpid)" "$(dev_agent_path "$NAME" bport)" 2>/dev/null || true
            # 後方互換: 旧・単一 agent／ブリッジ（グローバル方式時代）の残骸も掃除
            [ -S "$LEGACY_AGENT_SOCK" ] && SSH_AUTH_SOCK="$LEGACY_AGENT_SOCK" ssh-add -D 2>/dev/null || true
            for _f in "$LEGACY_BRIDGE_PID_FILE" "$LEGACY_AGENT_PID_FILE"; do
                [ -f "$_f" ] && kill "$(cat "$_f" 2>/dev/null)" 2>/dev/null || true
            done
            rm -rf "$LEGACY_AGENT_SOCK" 2>/dev/null || true
            rm -f "$LEGACY_BRIDGE_PID_FILE" "$LEGACY_BRIDGE_PORT_FILE" \
                  "$LEGACY_AGENT_PID_FILE" 2>/dev/null || true
            echo "✅ このプロジェクト（${NAME}）の SSH 鍵選択をリセットしました。再設定は 'claude-dev ssh-keys' で選択するか .claude-dev.yaml を作成してください"
            ;;
        ""|select)
            select_ssh_keys_interactive
            ;;
        *)
            echo "使い方: claude-dev ssh-keys [reset]"
            exit 1
            ;;
    esac
    ;;

# -----------------------------------------------------------------------------
# ポートフォワード（動的追加）
# -----------------------------------------------------------------------------
forward)
    if [ -z "$2" ]; then
        echo "使い方: claude-dev forward <container-port> [NAME]"
        echo "例:     claude-dev forward 3000"
        exit 1
    fi
    CPORT="$2"
    if [ -n "$3" ]; then
        NAME="$3"
    else
        NAME=$(container_name)
    fi

    if ! is_running "$NAME"; then
        echo "❌ ${NAME} は起動していません"
        exit 1
    fi

    # 既にフォワード済みか確認
    FWD_NAME="fwd-${NAME}-${CPORT}"
    if is_running "$FWD_NAME"; then
        _hport=$(docker port "$FWD_NAME" "$CPORT" 2>/dev/null | head -1 | sed 's/.*://')
        echo "ℹ️  既にフォワード済み: host:${_hport} → ${NAME}:${CPORT}"
        echo "   ブラウザで http://localhost:${_hport} にアクセス"
        exit 0
    fi
    if container_exists "$FWD_NAME"; then
        docker rm -f "$FWD_NAME" >/dev/null
    fi

    HPORT=$(find_available_host_port)
    docker run -d --rm \
        --name "$FWD_NAME" \
        --network "$NETWORK" \
        -p "${HPORT}:${CPORT}" \
        --entrypoint socat \
        "$IMG_CLAUDE" \
        "TCP-LISTEN:${CPORT},fork,reuseaddr" "TCP:${NAME}:${CPORT}" >/dev/null

    echo "✅ host:${HPORT} → ${NAME}:${CPORT}"
    echo "   ブラウザで http://localhost:${HPORT} にアクセス"
    ;;

# -----------------------------------------------------------------------------
# ポートフォワード解除
# -----------------------------------------------------------------------------
unforward)
    if [ -z "$2" ]; then
        echo "使い方: claude-dev unforward <container-port> [NAME]"
        exit 1
    fi
    CPORT="$2"
    if [ -n "$3" ]; then
        NAME="$3"
    else
        NAME=$(container_name)
    fi
    FWD_NAME="fwd-${NAME}-${CPORT}"
    if container_exists "$FWD_NAME"; then
        docker rm -f "$FWD_NAME" >/dev/null
        echo "✅ ${NAME}:${CPORT} のフォワードを解除しました"
    else
        echo "ℹ️  ${NAME}:${CPORT} のフォワードはありません"
    fi
    ;;

# -----------------------------------------------------------------------------
# ポートフォワード一覧
# -----------------------------------------------------------------------------
ports)
    if [ -n "$2" ]; then
        NAME="${2}"
    else
        NAME=$(container_name)
    fi

    if ! is_running "$NAME"; then
        echo "❌ ${NAME} は起動していません"
        exit 1
    fi

    echo "📡 ${NAME} のポートフォワード:"
    _has_fwd=0
    for cid in $(docker ps --filter "name=^fwd-${NAME}-" -q 2>/dev/null); do
        _has_fwd=1
        _fwd_name=$(docker inspect --format '{{.Name}}' "$cid" | sed 's|^/||')
        _cport="${_fwd_name##*-}"
        _hport=$(docker port "$_fwd_name" "$_cport" 2>/dev/null | head -1 | sed 's/.*://')
        [ -n "$_hport" ] && echo "   host:${_hport} → ${NAME}:${_cport}  (http://localhost:${_hport})"
    done
    [ $_has_fwd -eq 0 ] && echo "   (なし — claude-dev forward <port> で追加)"

    _url=$(get_novnc_url "$NAME")
    if [ -n "$_url" ]; then
        echo ""
        echo "🖥️  noVNC: $_url"
    fi
    ;;

# -----------------------------------------------------------------------------
# 実行中セッション一覧
# -----------------------------------------------------------------------------
list)
    echo "=== 実行中の Claude Code セッション ==="
    _has_containers=0
    for cid in $(docker ps --filter "ancestor=$IMG_CLAUDE" --filter "ancestor=$IMG_CLAUDE_VNC" -q 2>/dev/null); do
        _has_containers=1
        cname=$(docker inspect --format '{{.Name}}' "$cid" | sed 's|^/||')
        _name="${cname}"
        _status=$(docker inspect --format '{{.State.Status}}' "$cid")
        _workspace=$(docker inspect --format '{{range .Mounts}}{{if eq .Destination "/workspace"}}{{.Source}}{{end}}{{end}}' "$cid")
        _novnc_url=$(get_novnc_url "$cname")
        echo ""
        echo "  NAME:      ${_name}"
        echo "  STATUS:    ${_status}"
        echo "  WORKSPACE: ${_workspace}"
        [ -n "$_novnc_url" ] && echo "  noVNC:     ${_novnc_url}"
        # フォワードコンテナを列挙
        for _fid in $(docker ps --filter "name=^fwd-${cname}-" -q 2>/dev/null); do
            _fn=$(docker inspect --format '{{.Name}}' "$_fid" | sed 's|^/||')
            _cp="${_fn##*-}"
            _hp=$(docker port "$_fn" "$_cp" 2>/dev/null | head -1 | sed 's/.*://')
            [ -n "$_hp" ] && echo "  FORWARD:   host:${_hp} → ${cname}:${_cp}  (http://localhost:${_hp})"
        done
    done
    if [ $_has_containers -eq 0 ]; then
        echo "  (実行中のセッションはありません)"
    fi

    # Docker Socket Proxy コンテナの状態
    echo ""
    echo "=== Docker Socket Proxy コンテナ ==="
    if is_running "$DOCKER_PROXY_CONTAINER"; then
        echo "  STATUS:  running"
    else
        echo "  STATUS:  stopped（claude-dev start で自動起動）"
    fi

    ;;

# -----------------------------------------------------------------------------
# Claude Code アップグレード
# -----------------------------------------------------------------------------
upgrade)
    echo "📦 Claude ベースイメージを更新中..."
    docker build --no-cache -t "$IMG_CLAUDE" \
        --target claude-cli \
        --build-arg USERNAME="$CUSER" \
        --build-arg USER_UID="$(id -u)" \
        --build-arg USER_GID="$(id -g)" \
        -f "${BASE_DIR}/.devcontainer/Dockerfile.claude" "$BASE_DIR"
    echo "✅ Claude ベースイメージ更新完了"

    echo ""
    echo "📦 Claude VNC イメージを更新中..."
    docker build --no-cache -t "$IMG_CLAUDE_VNC" \
        --target claude-vnc \
        --build-arg USERNAME="$CUSER" \
        --build-arg USER_UID="$(id -u)" \
        --build-arg USER_GID="$(id -g)" \
        -f "${BASE_DIR}/.devcontainer/Dockerfile.claude" "$BASE_DIR"
    echo "✅ Claude VNC イメージ更新完了"

    echo ""
    echo "📦 Docker Socket Proxy イメージを更新中..."
    docker build --no-cache -t "$IMG_DOCKER_PROXY" \
        -f "${BASE_DIR}/.devcontainer/Dockerfile.docker-proxy" "$BASE_DIR"
    echo "✅ Docker Socket Proxy イメージ更新完了"

    echo ""
    echo "   実行中のコンテナは stop → start で反映されます"
    ;;

# -----------------------------------------------------------------------------
# ファイアウォール確認
# -----------------------------------------------------------------------------
firewall)
    NAME=$(container_name)
    if ! is_running "$NAME"; then
        echo "❌ コンテナが起動していません"
        exit 1
    fi
    docker exec "$NAME" iptables -L OUTPUT -n --line-numbers
    ;;

# -----------------------------------------------------------------------------
# 全リセット
# -----------------------------------------------------------------------------
reset)
    # 引数解析（--yes のみ。それ以外は無視する）
    _yes=0
    for _a in "$@"; do [ "$_a" = "--yes" ] && _yes=1; done

    # 共有ボリュームとイメージまで消す操作なので共有資源単位のロックを取る。
    # 取れなければ何も削除しない（FR-env-01 受入基準16）
    acquire_lock shared reset shared || exit 1

    # --- 削除対象の列挙 ---
    # Claude コンテナは管理ラベルを持つものだけ（イメージからの逆引きは使わない）。
    _rc_containers=()
    while IFS= read -r _c; do
        [ -n "$_c" ] && _rc_containers+=("$_c")
    done < <(docker ps -a --filter "label=claude-dev.managed=1" --format '{{.Names}}' 2>/dev/null || true)
    # fwd-* 中継コンテナは固定接頭辞で識別する（ラベルを見ない）
    _rc_fwd=()
    while IFS= read -r _c; do
        [ -n "$_c" ] && _rc_fwd+=("$_c")
    done < <(docker ps -a --filter "name=^fwd-" --format '{{.Names}}' 2>/dev/null || true)
    # ボリューム: 共有3本 + コンテナごとの Chrome プロファイル（名前で一意に決まる）
    _rc_volumes=()
    for _v in "$VOL_AUTH" "$VOL_HISTORY" "$VOL_CONFIG"; do
        docker volume inspect "$_v" >/dev/null 2>&1 && _rc_volumes+=("$_v")
    done
    while IFS= read -r _v; do
        [ -n "$_v" ] && _rc_volumes+=("$_v")
    done < <(docker volume ls -q --filter "name=^${VOL_CHROME_PREFIX}-" 2>/dev/null || true)
    # イメージ: 固定名
    _rc_images=()
    for _i in "$IMG_CLAUDE" "$IMG_CLAUDE_VNC" "$IMG_DOCKER_PROXY"; do
        image_exists "$_i" && _rc_images+=("$_i")
    done
    # セッション由来の資源（規則D）: claude-dev.role=spawned を持つコンテナとネットワークを
    # **所有者を問わず**すべて挙げる（FR-env-01 受入基準25）。reset は対象を絞る引数を持たない
    # 「ホスト全体」の操作なので、所有者で絞ると stop と同じ意味になってしまう。
    # 名前付きボリュームは対象にしない（D0-env-05 項2）。
    # **問い合わせに失敗したら握らない**（reset は D0-env-08 項5 の対象。0 件と区別する）。
    _rc_spawned_c=()
    _rc_spawned_n=()
    _rc_spawned_query_failed=()
    if _q=$(spawned_resources container "claude-dev.role=spawned"); then
        while IFS= read -r _c; do [ -n "$_c" ] && _rc_spawned_c+=("$_c"); done <<< "$_q"
    else
        _rc_spawned_query_failed+=("セッション由来のコンテナの列挙（Docker への問い合わせに失敗）")
    fi
    if _q=$(spawned_resources network "claude-dev.role=spawned"); then
        while IFS= read -r _c; do [ -n "$_c" ] && _rc_spawned_n+=("$_c"); done <<< "$_q"
    else
        _rc_spawned_query_failed+=("セッション由来のネットワークの列挙（Docker への問い合わせに失敗）")
    fi

    # 管理ラベルを持たない Claude コンテナ（削除しない。名前を表示して残す）。
    # **セッション由来のコンテナはここから除く**（CTR-cli-container「残したものをどう列挙するか」）。
    # それらは管理ラベルを持つので「ラベルを持たないコンテナ」ではなく、規則D が削除する。
    # 除かないと、claude-dev-net に手で繋いだセッション由来のコンテナが
    # 「削除する」と「ラベルを持たないので残した」の両方に出て、利用者が読める矛盾になる。
    _rc_unmanaged=()
    _rc_idle_query_ok=1
    if _others=$(net_other_running_containers); then
        while IFS= read -r _c; do
            [ -n "$_c" ] || continue
            _known=0
            for _t in "${_rc_containers[@]}"; do [ "$_t" = "$_c" ] && _known=1; done
            for _t in "${_rc_spawned_c[@]}"; do [ "$_t" = "$_c" ] && _known=1; done
            [ "$_known" = "0" ] && _rc_unmanaged+=("$_c")
        done <<< "$_others"
    else
        # 問い合わせに失敗した。「1つも無かった」と読み違えられないよう明示する（logout と同じ扱い）
        _rc_idle_query_ok=0
        echo "⚠️  ${NETWORK} への問い合わせに失敗したため、管理ラベルを持たないコンテナの列挙はできませんでした。"
    fi

    echo "⚠️  以下を削除します:"
    for _t in "${_rc_containers[@]}"; do echo "   - コンテナ: ${_t}"; done
    for _t in "${_rc_fwd[@]}";        do echo "   - 中継コンテナ: ${_t}"; done
    for _t in "${_rc_spawned_c[@]}";  do echo "   - セッション由来のコンテナ: ${_t}"; done
    for _t in "${_rc_spawned_n[@]}";  do echo "   - セッション由来のネットワーク: ${_t}"; done
    echo "   - Docker Socket Proxy コンテナ（遊休のときだけ）"
    echo "   - 共有ネットワーク ${NETWORK}（遊休のときだけ）"
    for _t in "${_rc_volumes[@]}"; do echo "   - ボリューム: ${_t}"; done
    for _t in "${_rc_images[@]}";  do echo "   - イメージ: ${_t}"; done
    if [ ${#_rc_unmanaged[@]} -gt 0 ]; then
        echo "   （管理ラベルを持たない次のコンテナは削除しません: ${_rc_unmanaged[*]}）"
    fi
    if [ ${#_rc_spawned_query_failed[@]} -gt 0 ]; then
        echo "⚠️  次の列挙に失敗しました（0 件だったのではなく、引けませんでした）:"
        for _t in "${_rc_spawned_query_failed[@]}"; do echo "   - ${_t}"; done
    fi
    echo ""

    # --- 確認 ---
    if [ "$_yes" != "1" ]; then
        if [ ! -t 0 ]; then
            echo "❌ 端末が無いため確認を求められません。何も削除していません。" >&2
            echo "   確認なしで実行するには 'claude-dev reset --yes' を指定してください。" >&2
            exit 1
        fi
        read -p "実行しますか？ (y/N) " -n 1 -r
        echo
        if [[ ! $REPLY =~ ^[Yy]$ ]]; then
            echo "キャンセルしました"
            exit 0
        fi
    fi

    # --- 削除 ---
    # 順序は コンテナ → docker-proxy と共有ネットワーク（遊休なら）→ ボリューム → イメージ
    # に固定する（使用中の参照を先に外さないと後段が必ず失敗する）。
    for _t in "${_rc_containers[@]}"; do destructive_plan "コンテナ: ${_t}"; done
    for _t in "${_rc_fwd[@]}";        do destructive_plan "中継コンテナ: ${_t}"; done
    for _t in "${_rc_spawned_c[@]}";  do destructive_plan "セッション由来のコンテナ: ${_t}"; done
    for _t in "${_rc_spawned_n[@]}";  do destructive_plan "セッション由来のネットワーク: ${_t}"; done
    # 列挙に失敗したものは「消えなかった資源」として最後に列挙し、終了コード 1 で終わる
    # （reset は D0-env-08 項5 の対象。握って「完了」と表示してはならない）。
    for _t in "${_rc_spawned_query_failed[@]}"; do destructive_plan "$_t"; destructive_failed "$_t"; done
    destructive_plan "Docker Socket Proxy コンテナ"
    destructive_plan "共有ネットワーク ${NETWORK}"
    for _t in "${_rc_volumes[@]}"; do destructive_plan "ボリューム: ${_t}"; done
    for _t in "${_rc_images[@]}";  do destructive_plan "イメージ: ${_t}"; done
    destructive_arm_interrupt

    for _t in "${_rc_containers[@]}"; do
        destructive_abort_if_interrupted
        if container_exists "$_t"; then
            destructive_rm "コンテナ: ${_t}" docker rm -f "$_t"
        else
            destructive_skipped "コンテナ: ${_t}"
        fi
    done
    for _t in "${_rc_fwd[@]}"; do
        destructive_abort_if_interrupted
        if container_exists "$_t"; then
            destructive_rm "中継コンテナ: ${_t}" docker rm -f "$_t"
        else
            destructive_skipped "中継コンテナ: ${_t}"
        fi
    done
    destructive_abort_if_interrupted
    # セッション由来の資源（規則D）。**コンテナ → ネットワークの順で固定**する
    # （逆順だと、接続しているコンテナがまだ生きているため docker network rm が必ず失敗し、
    # reset が毎回「削除できなかった資源」を列挙して終了コード 1 になる）。
    # **列挙し直さない**: 上の確認で見せた集合をそのまま消す。確認と削除のあいだに
    # 作られた資源を、列挙を経ずに消してはならない（FR-env-03 受入基準14）。
    # **stop と違い失敗を握らない**（reset は D0-env-08 項5 の対象である）。
    _spawned_reset_deleted=()
    for _t in "${_rc_spawned_c[@]}"; do
        destructive_abort_if_interrupted
        if container_exists "$_t"; then
            # destructive_rm は成否によらず 0 を返す（set -e で落とさないため）。
            # 成功したかは _DESTRUCTIVE_DELETED が伸びたかで見る。
            _n_before=${#_DESTRUCTIVE_DELETED[@]}
            destructive_rm "セッション由来のコンテナ: ${_t}" docker rm -f "$_t"
            [ ${#_DESTRUCTIVE_DELETED[@]} -gt "$_n_before" ] && _spawned_reset_deleted+=("コンテナ: ${_t}")
        else
            destructive_skipped "セッション由来のコンテナ: ${_t}"
        fi
    done
    for _t in "${_rc_spawned_n[@]}"; do
        destructive_abort_if_interrupted
        if docker network inspect "$_t" >/dev/null 2>&1; then
            _n_before=${#_DESTRUCTIVE_DELETED[@]}
            destructive_rm "セッション由来のネットワーク: ${_t}" docker network rm "$_t"
            [ ${#_DESTRUCTIVE_DELETED[@]} -gt "$_n_before" ] && _spawned_reset_deleted+=("ネットワーク: ${_t}")
        else
            destructive_skipped "セッション由来のネットワーク: ${_t}"
        fi
    done
    # 削除できた分を種別つきで 1 行ずつ表示する（FR-env-01 受入基準26）。0 件なら出さない（同27）。
    if [ ${#_spawned_reset_deleted[@]} -gt 0 ]; then
        echo "🧹 セッション由来の資源を削除しました（所有者は問いません）:"
        for _t in "${_spawned_reset_deleted[@]}"; do echo "   - ${_t}"; done
    fi
    destructive_abort_if_interrupted
    destructive_abort_if_interrupted

    # docker-proxy と共有ネットワークは遊休判定を通ったときだけ消す。手順3 で管理ラベルを
    # 持たない Claude コンテナを残しているため、この判定は空にならないことがある。
    # 無条件に消すと、残したコンテナの中から Docker が使えなくなり名前解決も壊れる。
    _reset_idle=0
    if _others=$(net_other_running_containers); then
        if [ -n "$_others" ]; then
            echo "🐳 ${NETWORK} に接続している稼働中のコンテナが残っているため、Docker Socket Proxy コンテナと共有ネットワークを残します:"
            printf '%s\n' "$_others" | sed 's/^/   - /'
            echo "   このため完全な初期化にはなっていません。残りの削除は続行します。"
        else
            _reset_idle=1
        fi
    else
        echo "⚠️  遊休判定に必要な Docker への問い合わせに失敗しました。安全側に倒して Docker Socket Proxy コンテナと共有ネットワークを残します。"
        echo "   このため完全な初期化にはなっていません。残りの削除は続行します。"
    fi
    if [ "$_reset_idle" = "1" ]; then
        if container_exists "$DOCKER_PROXY_CONTAINER"; then
            destructive_rm "Docker Socket Proxy コンテナ" docker rm -f "$DOCKER_PROXY_CONTAINER"
        else
            destructive_skipped "Docker Socket Proxy コンテナ"
        fi
        destructive_abort_if_interrupted
        if docker network inspect "$NETWORK" >/dev/null 2>&1; then
            destructive_rm "共有ネットワーク ${NETWORK}" docker network rm "$NETWORK"
        else
            destructive_skipped "共有ネットワーク ${NETWORK}"
        fi
    else
        # 残すと決めたものなので「失敗」には数えない
        destructive_skipped "Docker Socket Proxy コンテナ"
        destructive_skipped "共有ネットワーク ${NETWORK}"
    fi
    destructive_abort_if_interrupted

    for _t in "${_rc_volumes[@]}"; do
        destructive_abort_if_interrupted
        destructive_rm "ボリューム: ${_t}" docker volume rm -f "$_t"
    done
    destructive_abort_if_interrupted

    for _t in "${_rc_images[@]}"; do
        destructive_abort_if_interrupted
        destructive_rm "イメージ: ${_t}" docker rmi -f "$_t"
    done
    destructive_abort_if_interrupted

    # --- 結果 ---
    if [ ${#_DESTRUCTIVE_FAILED[@]} -gt 0 ]; then
        echo "❌ 削除できなかった資源があります。" >&2
        destructive_report >&2
        exit 1
    fi
    if [ "$_reset_idle" = "1" ]; then
        echo "✅ 全リセット完了"
    else
        echo "✅ 削除を完了しました（共有資源を残したため、完全な初期状態には戻っていません）"
    fi
    destructive_report
    if [ ${#_rc_unmanaged[@]} -gt 0 ]; then
        echo "ℹ️  管理ラベルを持たないため削除しなかったコンテナ（本変更より前に起動した可能性があります）:"
        for _c in "${_rc_unmanaged[@]}"; do echo "     - ${_c}"; done
        echo "   1件ずつ止めるには 'claude-dev stop <name>' を使ってください。"
        echo "   停止中のものは列挙していません（ネットワークの接続情報からは稼働中しか分かりません）。"
    fi
    release_lock shared shared
    ;;

# -----------------------------------------------------------------------------
# ヘルプ
# -----------------------------------------------------------------------------
help|*)
    cat << 'EOF'
claude-dev - Claude Code 安全開発環境（macOS 版）

セットアップ（初回のみ）:
  claude-dev setup               イメージビルド + インフラ構築
  claude-dev pull [TAG]          GHCR からビルド済みイメージを取得（ビルドの代わり。既定 latest）
  claude-dev login               Claude の OAuth ログイン
  claude-dev login-codex         Codex のデバイス認証ログイン（codex login --device-auth）
  claude-dev logout [--yes]      認証情報を削除（Claude / Codex 双方。--yes で確認を省く）
  claude-dev ssh-keys [reset]    コンテナへ転送する SSH 鍵を対話選択（reset で初期化）

開発:
  claude-dev start               カレントディレクトリで環境を起動（VNC + Chrome 付き）
  claude-dev start --no-vnc      Chrome / VNC なしで起動（軽量）
  claude-dev code                新しい tmux ウィンドウで Claude Code を起動
  claude-dev attach [NAME]       既存セッションに接続
  claude-dev stop [NAME]         セッションを停止
  claude-dev list                実行中セッション一覧

ポートフォワード:
  claude-dev forward <PORT> [NAME]    ポートを動的に追加
  claude-dev unforward <PORT> [NAME]  ポートフォワード解除
  claude-dev ports [NAME]             ポートフォワード一覧

メンテナンス:
  claude-dev upgrade             全イメージを更新（--no-cache 再ビルド）
  claude-dev firewall            ファイアウォールルール確認
  claude-dev reset [--yes]       全削除（コンテナ・ボリューム・イメージ。--yes で確認を省く）

使い方:
  cd ~/repos/my-project && claude-dev start

  デフォルトでは VNC + Chrome 付きコンテナが起動します。
  --no-vnc を指定すると Chrome / VNC なしの軽量コンテナで起動します。
  VNC ありの場合、noVNC URL は起動時に表示され、手元のブラウザで直接開けます。
  日本語入力は Super+Space で切り替え（IBus-Mozc）。

  ※ VM/KVM モード（--vm / --kvm）は macOS では非対応です。

[NAME] について:
  NAME はプロジェクトのディレクトリ名です。
  省略するとカレントディレクトリから自動判定します。
  claude-dev list で実行中セッションの NAME を確認できます。

Web アプリへのアクセス（macOS はローカルなので直結）:
  1. claude-dev start           → コンテナ起動
  2. claude-dev forward 3000    → ポートフォワードを動的追加（ホスト側ポートは自動割当）
  3. ブラウザで http://localhost:<host-port> にアクセス
EOF
    ;;
esac
