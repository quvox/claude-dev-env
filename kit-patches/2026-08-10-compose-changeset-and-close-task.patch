+#!/usr/bin/env python3
+"""close-task.py の削除ゲートの fixture。
+
+とくに条件 (b) を見る。**SSOT ドキュメントを削除するタスク**では、その target に
+検証済み記録を要求してはならない — 実体が無いので合格証を持ちようがなく、
+要求すると SSOT を削除するタスクは構造的に閉じられない。
+(検出経緯: task-remove-orchestrator。`docs/feedbacks/026` の #7)
+"""
+import subprocess, tempfile
+from pathlib import Path
+
+SCRIPT = Path(__file__).with_name("close-task.py")
+
+MEMO = """---
+id: task-x
+phase: 反映
+origin_layer: 02
+issue: なし
+lane: standard
+date: 2026-01-01
+updated: 2026-08-10
+source:
+  - docs/02-design/keep.md
+{extra_source}
+summary: fixture
+---
+
+# task-x fixture
+
+## 目的
+
+fixture
+
+## やること・やらないこと
+
+| 種別 | 内容 |
+|---|---|
+| やること | fixture |
+
+## 影響範囲(closure)
+
+| 層 | SSOT のパス | 変更指示のパス | 変更の種類 |
+|---|---|---|---|
+| 02 | docs/02-design/keep.md | new-features/02-design/keep.md | replace |
+{extra_row}
+
+## 読む範囲(読了記録)
+
+- 全文読了: 2026-08-10
+
+## 決定シート(回答済み)
+> 回答済み
+
+## 未決点
+
+未決点なし
+
+## 調査メモ
+
+なし
+
+## 質問キュー(未提示)
+
+なし
+
+## タスクリスト
+
+- [x] 1. fixture
+
+## Definition of Done
+
+- [x] fixture が通る
+
+## 進捗メモ
+
+- 2026-08-10 fixture
+
+## 申し送り事項
+
+- なし
+"""
+
+KEEP_SSOT = """---
+id: keep
+version: 1.1.0
+updated: 2026-08-10
+source: []
+summary: keep
+keywords: [k]
+verified:
+  at: 2026-08-10
+  version: 1.1.0
+  against: []
+---
+
+# Keep
+"""
+
+
+def build(root: Path, *, with_delete: bool) -> None:
+    (root / ".claude").mkdir(exist_ok=True)
+    (root / "CLAUDE.md").write_text("# fixture\n")
+    (root / "docs/02-design").mkdir(parents=True, exist_ok=True)
+    (root / "docs/02-design/keep.md").write_text(KEEP_SSOT)
+    nf = root / "docs/tasks/task-x/new-features/02-design"
+    nf.mkdir(parents=True, exist_ok=True)
+    (nf / "keep.md").write_text("---\ntarget: docs/02-design/keep.md\nchange: replace\n"
+                                "version_bump: minor\nsections: []\ndeletes: []\n"
+                                "reason: fixture\nreflected: 2026-08-10\n---\n\n本文\n")
+    extra_source = extra_row = ""
+    if with_delete:
+        # 反映済みの削除。SSOT 側の実体はもう無い(それが正しい姿)
+        (nf / "gone.md").write_text("---\ntarget: docs/02-design/gone.md\nchange: delete\n"
+                                    "reason: 対象ごと廃止する\nreflected: 2026-08-10\n---\n\n削除理由\n")
+        extra_source = "  - docs/02-design/gone.md"
+        extra_row = "| 02 | docs/02-design/gone.md | new-features/02-design/gone.md | delete |"
+    (root / "docs/tasks/task-x/memo.md").write_text(
+        MEMO.format(extra_source=extra_source, extra_row=extra_row))
+
+
+def run(root: Path):
+    # close-task.py は --root を持たず cwd からルートを探す(find_root)
+    return subprocess.run(["python3", str(SCRIPT), "--check", "task-x"],
+                          cwd=str(root), capture_output=True, text=True)
+
+
+def main() -> int:
+    # (1) 削除を含まないタスク: (a)(b)(c)(f) が通る
+    with tempfile.TemporaryDirectory() as td:
+        r = Path(td); build(r, with_delete=False)
+        p = run(r)
+        for cond in ("(a) 変更指示の SSOT 反映", "(b) 影響範囲の検証済み記録",
+                     "(c) Definition of Done", "(f) 影響範囲の表"):
+            assert cond in p.stdout, f"{cond} が出ていない\n{p.stdout}\n{p.stderr}"
+        assert "NG" not in p.stdout.split("### (d)")[0], f"(a)〜(c) で NG が出た:\n{p.stdout}"
+
+    # (2) SSOT を削除するタスク: 削除した target に検証済み記録を要求しない
+    with tempfile.TemporaryDirectory() as td:
+        r = Path(td); build(r, with_delete=True)
+        p = run(r)
+        head = p.stdout.split("### (d)")[0]
+        assert "gone.md — ファイルが存在しない" not in head, \
+            f"削除した SSOT に合格証を要求している(SSOT を削除するタスクが閉じられない):\n{p.stdout}"
+        assert "このタスクが削除した SSOT: 1 件" in head, \
+            f"削除した target を黙って落としている(理由つきで出すこと):\n{p.stdout}"
+        assert "NG" not in head, f"(a)〜(c) で NG が出た:\n{p.stdout}"
+
+    # (3) --check は削除しない
+    with tempfile.TemporaryDirectory() as td:
+        r = Path(td); build(r, with_delete=True); run(r)
+        assert (r / "docs/tasks/task-x/memo.md").is_file(), "--check なのに削除した"
+
+    print("OK close-task: reflected/certificate/DoD/source + deleted-target-exempt/--check-is-readonly")
+    return 0
+
+
+if __name__ == "__main__":
+    raise SystemExit(main())
