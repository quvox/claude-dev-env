+def check_frontmatter_shape(rel: str, text: str) -> None:
+    """合成結果の frontmatter が「top-level キー + その継続行」だけで出来ているか。
+
+    `verified:` は入れ子ブロックである。キー行だけを落とすと `at:` / `against:` が
+    宙に浮き、**frontmatter が YAML として壊れたまま反映される**(黙って壊れる系。
+    フィクスチャが `verified:` を1行スカラーで書いていたため回帰検査を素通りした)。
+    ここは合成器が自分の出力を見る唯一の場所なので、依存を増やさず構造だけを確かめる。
+    """
+    if not text.startswith("---"): return
+    fm, _ = fm_parts(text)
+    seen: set[str] = set()
+    for i, line in enumerate(fm.splitlines()):
+        if not line.strip(): continue
+        if line.lstrip().startswith("#"): continue      # 行まるごとのコメントは可(CLAUDE.md §7)
+        if line[0].isspace():
+            if i == 0: raise ValueError(f"{rel}: frontmatter の先頭がインデント行(親キーが落ちている)")
+            continue
+        m = re.match(r"^([\w-]+):", line)
+        if not m: raise ValueError(f"{rel}: frontmatter に key: でない行がある — {line[:60]!r}")
+        if m.group(1) in seen: raise ValueError(f"{rel}: frontmatter の top-level キーが重複 — {m.group(1)}")
+        seen.add(m.group(1))
+
+
+def check_relation_headings(rel: str, old: str, body: str) -> None:
+    """relations の replace は全文形式。SSOT にある `## ` 見出しを落としていないか。
+
+    未充填の見出しも保持するのが規範である(CLAUDE.md 原則9 / relations.md §4.1)ので、
+    「本文に無い = 削除」は relations では常に誤りである。**部分本文の変更指示を
+    全文置換として適用すると文書の大半が消える**(実測: 350 行 → 53 行)。
+    """
+    _, obody = fm_parts(old)
+    have = {l.strip() for l in body.splitlines() if l.startswith("## ")}
+    missing = [l.strip() for l in obody.splitlines() if l.startswith("## ") and l.strip() not in have]
+    if missing:
+        raise ValueError(f"{rel}: relations の replace は全文形式である。"
+                         f"SSOT にある見出しが本文に無い(落とすと本文が消える): {', '.join(missing)}")
+
+
+def fm_blocks(fm: str) -> dict:
+    """top-level key -> その行 + インデント継続行。"""
+    out, lines, i = {}, fm.splitlines(), 0
+    while i < len(lines):
+        m = re.match(r"^([\w-]+):", lines[i])
+        if not m: i += 1; continue
+        k, blk, i = m.group(1), [lines[i]], i + 1
+        while i < len(lines) and lines[i] and lines[i][0].isspace():
+            blk.append(lines[i]); i += 1
+        out[k] = blk
+    return out
+
+def merge_frontmatter(oldfm: str, fm: str) -> str:
+    src = {k: v for k, v in fm_blocks(fm).items() if k not in CONTROL and k not in COMPUTED}
+    if not src: return oldfm
+    out, old, i, seen = [], oldfm.splitlines(), 0, set()
+    while i < len(old):
+        m = re.match(r"^([\w-]+):", old[i])
+        if m and m.group(1) in src:
+            k = m.group(1); out += src[k]; seen.add(k); i += 1
+            while i < len(old) and old[i] and old[i][0].isspace(): i += 1
+        else:
+            out.append(old[i]); i += 1
+    for k, blk in src.items():
+        if k not in seen: out += blk
+    return "\n".join(out)
+
